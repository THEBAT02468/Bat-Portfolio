---
// Header.astro - LEGO Batman Design
---

<header class="header fixed w-full top-0 z-50">
  <!-- Top gold accent strip -->
  <div class="w-full h-0.5 bg-gradient-to-r from-transparent via-yellow-400 to-transparent opacity-80" style="box-shadow: 0 0 12px rgba(255,215,0,0.6);"></div>

  <nav class="container mx-auto flex justify-between items-center py-3 px-4 md:px-6">
    <!-- Logo -->
    <a href="/" class="flex items-center space-x-3 group">
      <div class="relative">
        <div class="absolute inset-0 rounded-full bg-yellow-400/20 blur-md group-hover:bg-yellow-400/40 transition-all duration-500"></div>
        <div class="relative w-10 h-10 rounded-full border-2 border-yellow-400/60 overflow-hidden group-hover:border-yellow-400 transition-all duration-300" style="box-shadow: 0 0 12px rgba(255,215,0,0.4);">
          <img
            src="/Bat-Ico.png"
            alt="Foto de perfil"
            class="w-10 h-10 rounded-full object-cover"
          />
        </div>
      </div>
      <div>
        <h1 class="text-lg md:text-xl font-black tracking-widest uppercase" style="font-family: 'Cinzel', serif; color: #FFD700; text-shadow: 0 0 12px rgba(255,215,0,0.7); letter-spacing: 0.1em;">
          Santiago López
        </h1>
        <p class="text-xs text-yellow-600/70 hidden md:block tracking-widest uppercase" style="font-family: 'Cinzel', serif; font-size: 0.55rem; letter-spacing: 0.2em;">
          ⬡ Gotham Developer ⬡
        </p>
      </div>
    </a>

    <!-- Desktop navigation -->
    <ul class="hidden md:flex space-x-8 items-center">
      <li>
        <a href="/" class="nav-link relative group">
          <span class="flex items-center gap-2 text-sm tracking-widest uppercase font-semibold">
            <i class="fas fa-home text-yellow-400 text-xs"></i>
            <span data-i18n="nav.home">Inicio</span>
          </span>
          <span class="nav-underline"></span>
        </a>
      </li>
      <li>
        <a href="/about" class="nav-link relative group">
          <span class="flex items-center gap-2 text-sm tracking-widest uppercase font-semibold">
            <i class="fas fa-user text-yellow-400 text-xs"></i>
            <span data-i18n="nav.about">Acerca de mí</span>
          </span>
          <span class="nav-underline"></span>
        </a>
      </li>
      <li>
        <a href="/projects" class="nav-link relative group">
          <span class="flex items-center gap-2 text-sm tracking-widest uppercase font-semibold">
            <i class="fas fa-code text-yellow-400 text-xs"></i>
            <span data-i18n="nav.projects">Proyectos</span>
          </span>
          <span class="nav-underline"></span>
        </a>
      </li>
      <li>
        <a href="/contact" class="nav-link relative group">
          <span class="flex items-center gap-2 text-sm tracking-widest uppercase font-semibold">
            <i class="fas fa-envelope text-yellow-400 text-xs"></i>
            <span data-i18n="nav.contact">Contacto</span>
          </span>
          <span class="nav-underline"></span>
        </a>
      </li>
    </ul>

    <!-- CV Button + Lang Toggle -->
    <div class="hidden md:flex items-center space-x-3">
      <!-- Language toggle -->
      <button
        id="lang-toggle"
        onclick="window.toggleLang()"
        title="Switch to English"
        class="flex items-center justify-center px-3 py-2 text-xs font-black tracking-widest uppercase transition-all duration-300"
        style="border: 1px solid rgba(255,215,0,0.4); color: #FFD700; font-family: 'Cinzel', serif; letter-spacing: 0.14em; min-width: 44px; background: rgba(255,215,0,0.04);"
        onmouseover="this.style.background='rgba(255,215,0,0.12)'; this.style.borderColor='rgba(255,215,0,0.8)'; this.style.boxShadow='0 0 14px rgba(255,215,0,0.3)'"
        onmouseout="this.style.background='rgba(255,215,0,0.04)'; this.style.borderColor='rgba(255,215,0,0.4)'; this.style.boxShadow='none'"
      >EN</button>
      <a
        href="/CV.pdf"
        download
        class="flex items-center gap-2 px-5 py-2 text-xs font-black tracking-widest uppercase text-black rounded"
        style="background: linear-gradient(135deg, #FFD700, #d97706); box-shadow: 0 0 16px rgba(255,215,0,0.5); font-family: 'Cinzel', serif; letter-spacing: 0.12em; transition: all 0.3s ease;"
        onmouseover="this.style.boxShadow='0 0 28px rgba(255,215,0,0.9)'; this.style.transform='translateY(-2px)'"
        onmouseout="this.style.boxShadow='0 0 16px rgba(255,215,0,0.5)'; this.style.transform='translateY(0)'"
      >
        <i class="fas fa-download text-xs"></i>
        CV
      </a>
    </div>

    <!-- Mobile menu button -->
    <button
      class="md:hidden flex flex-col space-y-1.5 p-3 rounded transition-colors"
      id="mobile-menu-button"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <span class="w-6 h-0.5 bg-yellow-400 transition-transform block" id="line1" style="box-shadow: 0 0 4px rgba(255,215,0,0.8);"></span>
      <span class="w-6 h-0.5 bg-yellow-400 transition-opacity block" id="line2" style="box-shadow: 0 0 4px rgba(255,215,0,0.8);"></span>
      <span class="w-6 h-0.5 bg-yellow-400 transition-transform block" id="line3" style="box-shadow: 0 0 4px rgba(255,215,0,0.8);"></span>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    class="md:hidden transition-all duration-300 ease-in-out overflow-hidden max-h-0"
    id="mobile-menu"
    style="background: rgba(0,0,0,0.98); border-top: 1px solid rgba(255,215,0,0.2);"
  >
    <div class="container mx-auto px-4 space-y-1 py-2">
      <a href="/" class="flex items-center py-3 px-4 mobile-nav-link" style="border-left: 2px solid rgba(255,215,0,0.3); transition: all 0.3s ease;">
        <i class="fas fa-home mr-3 text-yellow-400 w-5 text-sm"></i>
        <span class="text-sm tracking-widest uppercase font-semibold text-gray-300" data-i18n="nav.home">Inicio</span>
      </a>
      <a href="/about" class="flex items-center py-3 px-4 mobile-nav-link" style="border-left: 2px solid rgba(255,215,0,0.3); transition: all 0.3s ease;">
        <i class="fas fa-user mr-3 text-yellow-400 w-5 text-sm"></i>
        <span class="text-sm tracking-widest uppercase font-semibold text-gray-300" data-i18n="nav.about">Acerca de mí</span>
      </a>
      <a href="/projects" class="flex items-center py-3 px-4 mobile-nav-link" style="border-left: 2px solid rgba(255,215,0,0.3); transition: all 0.3s ease;">
        <i class="fas fa-code mr-3 text-yellow-400 w-5 text-sm"></i>
        <span class="text-sm tracking-widest uppercase font-semibold text-gray-300" data-i18n="nav.projects">Proyectos</span>
      </a>
      <a href="/contact" class="flex items-center py-3 px-4 mobile-nav-link" style="border-left: 2px solid rgba(255,215,0,0.3); transition: all 0.3s ease;">
        <i class="fas fa-envelope mr-3 text-yellow-400 w-5 text-sm"></i>
        <span class="text-sm tracking-widest uppercase font-semibold text-gray-300" data-i18n="nav.contact">Contacto</span>
      </a>
      <!-- Lang toggle mobile -->
      <div class="pt-2 pb-1 px-4">
        <button
          onclick="window.toggleLang()"
          class="flex items-center gap-2 text-xs font-black tracking-widest uppercase transition-all duration-300"
          style="color: #FFD700; font-family: 'Cinzel', serif; letter-spacing: 0.14em; background: none; border: none; cursor: pointer;"
        >
          <i class="fas fa-globe text-yellow-400 w-5 text-sm"></i>
          <span id="lang-toggle-mobile">EN</span>
        </button>
      </div>
      <div class="pt-3 pb-2 mt-2" style="border-top: 1px solid rgba(255,215,0,0.1);">
        <a
          href="/CV.pdf"
          download
          class="flex items-center justify-center py-3 px-4 text-black font-black text-xs tracking-widest uppercase rounded"
          style="background: linear-gradient(135deg, #FFD700, #d97706); box-shadow: 0 0 16px rgba(255,215,0,0.4);"
        >
          <i class="fas fa-download mr-2"></i>
          Descargar CV
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .header {
    background: rgba(0, 0, 0, 0.97);
    border-bottom: 1px solid rgba(255, 215, 0, 0.15);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .nav-link {
    color: #9ca3af;
    font-weight: 600;
    padding: 0.5rem 0;
    transition: color 0.3s ease;
    font-family: 'Cinzel', serif;
  }

  .nav-link:hover {
    color: #FFD700;
    text-shadow: 0 0 12px rgba(255, 215, 0, 0.8);
  }

  .nav-underline {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, #FFD700, transparent);
    transition: width 0.35s ease;
    box-shadow: 0 0 6px rgba(255, 215, 0, 0.8);
  }

  .nav-link:hover .nav-underline {
    width: 100%;
  }

  /* Mobile link hover */
  .mobile-nav-link:hover {
    border-left-color: rgba(255, 215, 0, 0.8) !important;
    background: rgba(255, 215, 0, 0.05);
  }

  .mobile-nav-link:hover span {
    color: #FFD700;
  }

  /* Burger animation */
  #mobile-menu.mobile-menu-open {
    max-height: 500px !important;
  }

  #mobile-menu-button.menu-open #line1 {
    transform: rotate(45deg) translateY(6px);
  }

  #mobile-menu-button.menu-open #line2 {
    opacity: 0;
  }

  #mobile-menu-button.menu-open #line3 {
    transform: rotate(-45deg) translateY(-6px);
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const menuButton = document.getElementById("mobile-menu-button") as HTMLButtonElement | null;
    const mobileMenu = document.getElementById("mobile-menu") as HTMLElement | null;
    const mobileNavLinks = document.querySelectorAll(".mobile-nav-link");

    if (!menuButton || !mobileMenu) return;

    let isMenuOpen = false;

    function toggleMenu() {
      isMenuOpen = !isMenuOpen;
      if (isMenuOpen) {
        mobileMenu!.classList.add("mobile-menu-open");
        menuButton!.classList.add("menu-open");
        menuButton!.setAttribute("aria-expanded", "true");
      } else {
        mobileMenu!.classList.remove("mobile-menu-open");
        menuButton!.classList.remove("menu-open");
        menuButton!.setAttribute("aria-expanded", "false");
      }
    }

    menuButton.addEventListener("click", toggleMenu);

    if (mobileNavLinks.length > 0) {
      mobileNavLinks.forEach(function (link) {
        link.addEventListener("click", function () {
          isMenuOpen = false;
          mobileMenu.classList.remove("mobile-menu-open");
          menuButton.classList.remove("menu-open");
          menuButton.setAttribute("aria-expanded", "false");
        });
      });
    }
  });
</script>
