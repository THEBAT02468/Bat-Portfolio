---
import "../styles/global.css";
import MusicPlayer from "../components/MusicPlayer.astro";
const { title } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/Bat-Ico.svg" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <script is:inline src="/rain-fix.js" defer></script>
    <script is:inline src="/i18n.js" defer></script>
  </head>
  <body class="bg-gotham-dark text-gotham-light">
    <MusicPlayer />
    <slot />
  </body>
</html>
