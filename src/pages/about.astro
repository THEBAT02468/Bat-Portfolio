---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackgroundAnimation from "../components/BackgroundAnimation.astro";
import WaterDrops from "../components/WaterDrops.astro";
import Smoke from "../components/Smoke.astro";
---

<Layout
  title="Acerca de mí - Santiago López | Gotham Developer"
  description="Conoce a Santiago López, desarrollador Full Stack & especialista en Ciberseguridad"
>
  <Smoke />
  <BackgroundAnimation />

  <div class="relative z-10">
    <WaterDrops />
    <Header />

    <!-- ── HERO ──────────────────────────────────────── -->
    <section class="min-h-screen flex flex-col justify-center items-center text-center px-6 py-20 relative overflow-hidden">
      <!-- Fondo negro con city grid -->
      <div class="absolute inset-0" style="background: rgba(0,0,0,0.50);">
        <div class="absolute inset-0 gotham-grid opacity-50"></div>
      </div>
      <!-- Ambient glows -->
      <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full blur-3xl pointer-events-none" style="background: radial-gradient(circle, rgba(255,215,0,0.06) 0%, transparent 70%);"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full blur-3xl pointer-events-none" style="background: radial-gradient(circle, rgba(0,212,255,0.05) 0%, transparent 70%);"></div>

      <div class="relative z-10 flex flex-col items-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-3 px-5 py-2 mb-10 mt-20"
          style="background: rgba(0,0,0,0.8); border: 1px solid rgba(255,215,0,0.4); box-shadow: 0 0 20px rgba(255,215,0,0.1);">
          <div class="relative">
            <div class="w-2 h-2 rounded-full animate-pulse" style="background: #00d4ff; box-shadow: 0 0 6px #00d4ff;"></div>
            <div class="absolute inset-0 w-2 h-2 rounded-full animate-ping opacity-60" style="background: #00d4ff;"></div>
          </div>
          <span class="text-xs font-black tracking-widest uppercase" style="color: #FFD700; font-family: 'Cinzel', serif; letter-spacing: 0.15em; text-shadow: 0 0 8px rgba(255,215,0,0.6);" data-i18n="about.badge">
            ⬡ Gotham Developer ⬡
          </span>
        </div>

        <!-- Título -->
        <h1 class="font-black mb-4" style="font-family: 'Cinzel Decorative', serif; font-size: clamp(2.5rem, 8vw, 6rem); letter-spacing: 0.05em; line-height: 1;">
          <span class="text-white" data-i18n="about.h1">ACERCA</span>
          <span class="block" style="color: #FFD700; text-shadow: 0 0 30px rgba(255,215,0,0.8), 0 0 60px rgba(255,215,0,0.4);" data-i18n="about.h2">DE MÍ</span>
        </h1>

        <!-- Foto de perfil -->
        <div class="relative mb-8 mt-4">
          <div class="absolute inset-0 rounded-full blur-xl" style="background: rgba(255,215,0,0.15);"></div>
          <div class="relative w-44 h-44 mx-auto overflow-hidden" style="border: 2px solid rgba(255,215,0,0.6); box-shadow: 0 0 30px rgba(255,215,0,0.3), inset 0 0 20px rgba(255,215,0,0.05);">
            <img src="/images/Yo.png" alt="Santiago López" class="w-full h-full object-cover" />
          </div>
          <!-- Badge debajo -->
          <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 px-4 py-1 text-xs font-black tracking-widest uppercase whitespace-nowrap"
            style="background: #FFD700; color: #000; font-family: 'Cinzel', serif; letter-spacing: 0.1em;">
            Dev Gotham
          </div>
        </div>

        <!-- Bio -->
        <p class="max-w-2xl text-gray-400 text-base md:text-lg leading-relaxed mb-8 mt-4" data-i18n="about.bio" data-i18n-html="true">
          Soy <span style="color:#FFD700;font-weight:700;text-shadow:0 0 8px rgba(255,215,0,0.5);">Santiago</span>, desarrollador de software enfocado en el diseño y construcción de soluciones web modernas, seguras y escalables. Me especializo en arquitecturas sólidas, atención al detalle y experiencia de usuario de alto nivel.
        </p>

        <!-- Badges de especialización -->
        <div class="flex flex-wrap justify-center gap-3 mb-8">
          <span class="flex items-center gap-2 px-4 py-2 text-sm font-bold"
            style="border: 1px solid rgba(255,107,107,0.5); color: #ff6b6b; background: rgba(255,107,107,0.05); text-shadow: 0 0 6px rgba(255,107,107,0.5);">
            <i class="fas fa-shield-alt text-xs"></i><span data-i18n="about.spec.cyber">Ciberseguridad</span>
          </span>
          <span class="flex items-center gap-2 px-4 py-2 text-sm font-bold"
            style="border: 1px solid rgba(0,212,255,0.5); color: #00d4ff; background: rgba(0,212,255,0.05); text-shadow: 0 0 6px rgba(0,212,255,0.5);">
            <i class="fas fa-user-secret text-xs"></i><span data-i18n="about.spec.hacking">Hacking Ético</span>
          </span>
          <span class="flex items-center gap-2 px-4 py-2 text-sm font-bold"
            style="border: 1px solid rgba(255,215,0,0.5); color: #FFD700; background: rgba(255,215,0,0.05); text-shadow: 0 0 6px rgba(255,215,0,0.5);">
            <i class="fas fa-code text-xs"></i>Full-Stack Dev
          </span>
        </div>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/projects"
            class="flex items-center justify-center gap-2 px-8 py-3 font-black text-xs tracking-widest uppercase transition-all duration-300 hover:scale-105"
            style="background: linear-gradient(135deg, #FFD700, #d97706); color: #000; border: 2px solid rgba(255,215,0,0.7); box-shadow: 0 0 20px rgba(255,215,0,0.4); font-family: 'Cinzel', serif; letter-spacing: 0.12em;"
            onmouseover="this.style.boxShadow='0 0 40px rgba(255,215,0,0.8)'"
            onmouseout="this.style.boxShadow='0 0 20px rgba(255,215,0,0.4)'">
            <i class="fas fa-code text-xs"></i> <span data-i18n="about.cta.projects">Ver Proyectos</span>
          </a>
          <a href="/contact"
            class="flex items-center justify-center gap-2 px-8 py-3 font-bold text-xs tracking-widest uppercase transition-all duration-300 hover:scale-105"
            style="border: 2px solid rgba(0,212,255,0.5); color: #00d4ff; font-family: 'Cinzel', serif; letter-spacing: 0.12em; box-shadow: 0 0 12px rgba(0,212,255,0.15);"
            onmouseover="this.style.background='rgba(0,212,255,0.08)'; this.style.boxShadow='0 0 25px rgba(0,212,255,0.4)'; this.style.borderColor='rgba(0,212,255,0.8)'"
            onmouseout="this.style.background='transparent'; this.style.boxShadow='0 0 12px rgba(0,212,255,0.15)'; this.style.borderColor='rgba(0,212,255,0.5)'">
            <i class="fas fa-envelope text-xs"></i> <span data-i18n="about.cta.contact">Contáctame</span>
          </a>
        </div>

        <!-- Scroll indicator (hidden on mobile to avoid overlapping CTAs) -->
        <div class="hidden md:flex absolute bottom-6 left-1/2 -translate-x-1/2 animate-bounce">
          <div class="flex flex-col items-center gap-1">
            <span class="text-xs font-black tracking-widest" style="color: #FFD700; font-family: 'Cinzel', serif; font-size: 0.5rem; letter-spacing: 0.25em;" data-i18n="about.scroll">DESCUBRE MÁS</span>
            <div class="w-5 h-9 flex justify-center" style="border: 1px solid rgba(255,215,0,0.4); box-shadow: 0 0 6px rgba(255,215,0,0.1);">
              <div class="w-0.5 h-2.5 mt-1.5 animate-pulse" style="background: #FFD700; box-shadow: 0 0 5px rgba(255,215,0,0.8);"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── CIBERSEGURIDAD ─────────────────────────────── -->
    <section class="py-20 md:py-28 px-6 relative overflow-hidden">
      <div class="absolute inset-0" style="background: rgba(0,0,0,0.50);">
        <div class="absolute inset-0 gotham-grid opacity-30"></div>
      </div>
      <div class="absolute top-0 left-0 right-0 h-px" style="background: linear-gradient(90deg, transparent, rgba(255,215,0,0.5), transparent); box-shadow: 0 0 8px rgba(255,215,0,0.3);"></div>
      <div class="absolute bottom-0 left-0 right-0 h-px" style="background: linear-gradient(90deg, transparent, rgba(0,212,255,0.3), transparent);"></div>

      <div class="container mx-auto relative">
        <!-- Divisor -->
        <div class="flex items-center justify-center gap-4 mb-6">
          <div class="flex-1 h-px" style="background: linear-gradient(90deg, transparent, rgba(255,215,0,0.3));"></div>
          <span style="color: #FFD700; font-size: 1.1rem; text-shadow: 0 0 12px rgba(255,215,0,0.9);">⬡</span>
          <div class="flex-1 h-px" style="background: linear-gradient(90deg, rgba(255,215,0,0.3), transparent);"></div>
        </div>
        <div class="text-center mb-4">
          <span class="text-xs font-black tracking-widest uppercase" style="color: #00d4ff; font-family: 'Cinzel', serif; letter-spacing: 0.2em; text-shadow: 0 0 8px rgba(0,212,255,0.7);" data-i18n="about.sec.label">─── Especialización ───</span>
        </div>
        <h2 class="text-center font-black mb-12 md:mb-16" style="font-family: 'Cinzel Decorative', serif; font-size: clamp(1.8rem, 5vw, 3.5rem); letter-spacing: 0.06em; line-height: 1.1;">
          <span class="text-white" data-i18n="about.sec.h1">CIBERSEGURIDAD &</span>
          <span class="block" style="color: #FFD700; text-shadow: 0 0 25px rgba(255,215,0,0.7);" data-i18n="about.sec.h2">HACKING ÉTICO</span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
          <!-- Pentesting -->
          <div class="security-card" style="--card-color: rgba(255,107,107,0.5); --card-glow: rgba(255,107,107,0.15);">
            <div class="security-icon" style="color: #ff6b6b; border: 1px solid rgba(255,107,107,0.4); box-shadow: 0 0 15px rgba(255,107,107,0.25);">
              <i class="fas fa-crosshairs"></i>
            </div>
            <h3 class="security-title" style="color: #ff6b6b; text-shadow: 0 0 8px rgba(255,107,107,0.5);" data-i18n="about.sec.pent.title">Pentesting</h3>
            <p class="security-desc" data-i18n="about.sec.pent.desc">Pruebas de penetración y auditorías de seguridad en aplicaciones web y redes.</p>
            <ul class="security-skills">
              <li><i class="fas fa-chevron-right mr-2" style="color: #FFD700; font-size: 0.6rem;"></i>OWASP Top 10</li>
              <li><i class="fas fa-chevron-right mr-2" style="color: #FFD700; font-size: 0.6rem;"></i>Metasploit</li>
              <li><i class="fas fa-chevron-right mr-2" style="color: #FFD700; font-size: 0.6rem;"></i>Burp Suite</li>
            </ul>
          </div>

          <!-- Análisis de Vulnerabilidades -->
          <div class="security-card" style="--card-color: rgba(255,165,2,0.5); --card-glow: rgba(255,165,2,0.15);">
            <div class="security-icon" style="color: #ffa502; border: 1px solid rgba(255,165,2,0.4); box-shadow: 0 0 15px rgba(255,165,2,0.25);">
              <i class="fas fa-bug"></i>
            </div>
            <h3 class="security-title" style="color: #ffa502; text-shadow: 0 0 8px rgba(255,165,2,0.5);" data-i18n="about.sec.vuln.title">Análisis de Vulnerabilidades</h3>
            <p class="security-desc" data-i18n="about.sec.vuln.desc">Identificación y remediación de vulnerabilidades en código e infraestructura.</p>
            <ul class="security-skills">
              <li><i class="fas fa-chevron-right mr-2" style="color: #FFD700; font-size: 0.6rem;"></i>SAST/DAST</li>
              <li><i class="fas fa-chevron-right mr-2" style="color: #FFD700; font-size: 0.6rem;"></i>Nessus</li>
              <li><i class="fas fa-chevron-right mr-2" style="color: #FFD700; font-size: 0.6rem;"></i>Nmap</li>
            </ul>
          </div>

          <!-- Seguridad Web -->
          <div class="security-card" style="--card-color: rgba(0,212,255,0.5); --card-glow: rgba(0,212,255,0.15);">
            <div class="security-icon" style="color: #00d4ff; border: 1px solid rgba(0,212,255,0.4); box-shadow: 0 0 15px rgba(0,212,255,0.25);">
              <i class="fas fa-globe"></i>
            </div>
            <h3 class="security-title" style="color: #00d4ff; text-shadow: 0 0 8px rgba(0,212,255,0.5);" data-i18n="about.sec.web.title">Seguridad Web</h3>
            <p class="security-desc" data-i18n="about.sec.web.desc">Protección contra ataques comunes como XSS, SQLi, CSRF y más.</p>
            <ul class="security-skills">
              <li><i class="fas fa-chevron-right mr-2" style="color: #FFD700; font-size: 0.6rem;"></i>WAF</li>
              <li><i class="fas fa-chevron-right mr-2" style="color: #FFD700; font-size: 0.6rem;"></i>HTTPS/TLS</li>
              <li><i class="fas fa-chevron-right mr-2" style="color: #FFD700; font-size: 0.6rem;"></i>Content Security Policy</li>
            </ul>
          </div>

          <!-- Forense Digital -->
          <div class="security-card" style="--card-color: rgba(139,92,246,0.5); --card-glow: rgba(139,92,246,0.15);">
            <div class="security-icon" style="color: #8b5cf6; border: 1px solid rgba(139,92,246,0.4); box-shadow: 0 0 15px rgba(139,92,246,0.25);">
              <i class="fas fa-search"></i>
            </div>
            <h3 class="security-title" style="color: #8b5cf6; text-shadow: 0 0 8px rgba(139,92,246,0.5);" data-i18n="about.sec.for.title">Forense Digital</h3>
            <p class="security-desc" data-i18n="about.sec.for.desc">Investigación de incidentes de seguridad y análisis de evidencias digitales.</p>
            <ul class="security-skills">
              <li><i class="fas fa-chevron-right mr-2" style="color: #FFD700; font-size: 0.6rem;"></i>Análisis de logs</li>
              <li><i class="fas fa-chevron-right mr-2" style="color: #FFD700; font-size: 0.6rem;"></i>Memory forensics</li>
              <li><i class="fas fa-chevron-right mr-2" style="color: #FFD700; font-size: 0.6rem;"></i>Autopsy</li>
            </ul>
          </div>

          <!-- Hardening -->
          <div class="security-card" style="--card-color: rgba(255,215,0,0.5); --card-glow: rgba(255,215,0,0.15);">
            <div class="security-icon" style="color: #FFD700; border: 1px solid rgba(255,215,0,0.4); box-shadow: 0 0 15px rgba(255,215,0,0.25);">
              <i class="fas fa-lock"></i>
            </div>
            <h3 class="security-title" style="color: #FFD700; text-shadow: 0 0 8px rgba(255,215,0,0.5);" data-i18n="about.sec.hard.title">Hardening</h3>
            <p class="security-desc" data-i18n="about.sec.hard.desc">Fortalecimiento de sistemas y aplicaciones contra posibles ataques.</p>
            <ul class="security-skills">
              <li><i class="fas fa-chevron-right mr-2" style="color: #FFD700; font-size: 0.6rem;"></i>Configuración segura</li>
              <li><i class="fas fa-chevron-right mr-2" style="color: #FFD700; font-size: 0.6rem;"></i>Bastionado</li>
              <li><i class="fas fa-chevron-right mr-2" style="color: #FFD700; font-size: 0.6rem;"></i>Mínimo privilegio</li>
            </ul>
          </div>

          <!-- Concienciación -->
          <div class="security-card" style="--card-color: rgba(0,212,255,0.4); --card-glow: rgba(0,212,255,0.1);">
            <div class="security-icon" style="color: #00d4ff; border: 1px solid rgba(0,212,255,0.4); box-shadow: 0 0 15px rgba(0,212,255,0.2);">
              <i class="fas fa-users"></i>
            </div>
            <h3 class="security-title" style="color: #00d4ff; text-shadow: 0 0 8px rgba(0,212,255,0.5);" data-i18n="about.sec.aw.title">Concienciación</h3>
            <p class="security-desc" data-i18n="about.sec.aw.desc">Capacitación en seguridad para equipos de desarrollo y usuarios finales.</p>
            <ul class="security-skills">
              <li><i class="fas fa-chevron-right mr-2" style="color: #FFD700; font-size: 0.6rem;"></i>Phishing awareness</li>
              <li><i class="fas fa-chevron-right mr-2" style="color: #FFD700; font-size: 0.6rem;"></i>Best practices</li>
              <li><i class="fas fa-chevron-right mr-2" style="color: #FFD700; font-size: 0.6rem;"></i>Security training</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ── HABILIDADES ────────────────────────────────── -->
    <section class="py-20 md:py-28 px-6 relative overflow-hidden">
      <div class="absolute inset-0" style="background: rgba(0,0,0,0.50);">
        <div class="absolute inset-0 gotham-grid opacity-50"></div>
      </div>
      <div class="absolute top-0 left-0 right-0 h-px" style="background: linear-gradient(90deg, transparent, rgba(255,215,0,0.4), transparent);"></div>

      <div class="container mx-auto relative">
        <div class="text-center mb-4">
          <span class="text-xs font-black tracking-widest uppercase" style="color: #00d4ff; font-family: 'Cinzel', serif; letter-spacing: 0.2em; text-shadow: 0 0 8px rgba(0,212,255,0.7);" data-i18n="about.skills.label">─── Stack & Dominio ───</span>
        </div>
        <h2 class="text-center font-black mb-12 md:mb-16" style="font-family: 'Cinzel Decorative', serif; font-size: clamp(1.8rem, 5vw, 3.5rem); letter-spacing: 0.06em; line-height: 1.1;">
          <span class="text-white" data-i18n="about.skills.h1">MIS </span>
          <span style="color: #FFD700; text-shadow: 0 0 25px rgba(255,215,0,0.7);" data-i18n="about.skills.h2">HABILIDADES</span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
          <div class="skill-card" style="--skill-color: #FFD700; --skill-glow: rgba(255,215,0,0.2);">
            <div class="skill-icon" style="color: #FFD700; border: 1px solid rgba(255,215,0,0.4); box-shadow: 0 0 12px rgba(255,215,0,0.2);">
              <i class="fas fa-paint-brush"></i>
            </div>
            <h3 class="skill-title">Frontend</h3>
            <p class="skill-desc" data-i18n="about.skills.fe.desc">React, Vue, Astro, Tailwind</p>
            <div class="skill-bar">
              <div class="skill-progress" style="width: 90%; background: linear-gradient(90deg, #FFD700, #fff200);"></div>
            </div>
            <span class="skill-pct">90%</span>
          </div>

          <div class="skill-card" style="--skill-color: #8b5cf6; --skill-glow: rgba(139,92,246,0.2);">
            <div class="skill-icon" style="color: #8b5cf6; border: 1px solid rgba(139,92,246,0.4); box-shadow: 0 0 12px rgba(139,92,246,0.2);">
              <i class="fas fa-server"></i>
            </div>
            <h3 class="skill-title" style="color: #8b5cf6;">Backend</h3>
            <p class="skill-desc" data-i18n="about.skills.be.desc">Node.js, Express, MongoDB</p>
            <div class="skill-bar">
              <div class="skill-progress" style="width: 85%; background: linear-gradient(90deg, #8b5cf6, #a78bfa);"></div>
            </div>
            <span class="skill-pct" style="color: #8b5cf6;">85%</span>
          </div>

          <div class="skill-card" style="--skill-color: #ff6b6b; --skill-glow: rgba(255,107,107,0.2);">
            <div class="skill-icon" style="color: #ff6b6b; border: 1px solid rgba(255,107,107,0.4); box-shadow: 0 0 12px rgba(255,107,107,0.2);">
              <i class="fas fa-shield-alt"></i>
            </div>
            <h3 class="skill-title" style="color: #ff6b6b;">Ciberseguridad</h3>
            <p class="skill-desc" data-i18n="about.skills.sec.desc">Pentesting, Forense, Hardening</p>
            <div class="skill-bar">
              <div class="skill-progress" style="width: 80%; background: linear-gradient(90deg, #ff6b6b, #ff9f9f);"></div>
            </div>
            <span class="skill-pct" style="color: #ff6b6b;">80%</span>
          </div>

          <div class="skill-card" style="--skill-color: #00d4ff; --skill-glow: rgba(0,212,255,0.2);">
            <div class="skill-icon" style="color: #00d4ff; border: 1px solid rgba(0,212,255,0.4); box-shadow: 0 0 12px rgba(0,212,255,0.2);">
              <i class="fas fa-bolt"></i>
            </div>
            <h3 class="skill-title" style="color: #00d4ff;" data-i18n="about.skills.do.title">DevOps & Cloud</h3>
            <p class="skill-desc" data-i18n="about.skills.do.desc">Docker, AWS, CI/CD</p>
            <div class="skill-bar">
              <div class="skill-progress" style="width: 75%; background: linear-gradient(90deg, #00d4ff, #67e8ff);"></div>
            </div>
            <span class="skill-pct" style="color: #00d4ff;">75%</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── TRAYECTORIA ───────────────────────────────── -->
    <section class="py-20 md:py-28 px-6 relative overflow-hidden">
      <div class="absolute inset-0" style="background: rgba(0,0,0,0.50);">
        <div class="absolute inset-0 gotham-grid opacity-30"></div>
      </div>
      <div class="absolute top-0 left-0 right-0 h-px" style="background: linear-gradient(90deg, transparent, rgba(0,212,255,0.4), transparent);"></div>
      <div class="absolute bottom-0 left-0 right-0 h-px" style="background: linear-gradient(90deg, transparent, rgba(255,215,0,0.3), transparent);"></div>

      <div class="container mx-auto relative">
        <div class="text-center mb-4">
          <span class="text-xs font-black tracking-widest uppercase" style="color: #00d4ff; font-family: 'Cinzel', serif; letter-spacing: 0.2em; text-shadow: 0 0 8px rgba(0,212,255,0.7);" data-i18n="about.tl.label">─── Experiencia ───</span>
        </div>
        <h2 class="text-center font-black mb-12 md:mb-16" style="font-family: 'Cinzel Decorative', serif; font-size: clamp(1.8rem, 5vw, 3.5rem); letter-spacing: 0.06em; line-height: 1.1;">
          <span class="text-white" data-i18n="about.tl.h1">MI </span>
