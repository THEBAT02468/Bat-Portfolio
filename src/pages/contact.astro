---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackgroundAnimation from "../components/BackgroundAnimation.astro";
import WaterDrops from "../components/WaterDrops.astro";
import Smoke from "../components/Smoke.astro";
---

<Layout
  title="Contacto - Santiago López | Desarrollador Full Stack"
  description="Contacta con Santiago López, desarrollador full stack especializado en soluciones web seguras y escalables"
>
  <Smoke />
  <BackgroundAnimation />

  <div class="relative z-10">
    <WaterDrops />
    <Header />

    <!-- ── HERO ──────────────────────────────────────── -->
    <section class="relative min-h-[70vh] flex flex-col justify-center items-center text-center px-4 py-16 mt-16 overflow-hidden">
      <div class="absolute inset-0" style="background: rgba(0,0,0,0.50);">
        <div class="absolute inset-0 gotham-grid opacity-50"></div>
      </div>
      <!-- Ambient glow -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(255,215,0,0.06) 0%, transparent 65%);"></div>
      <div class="absolute top-1/3 right-1/4 w-64 h-64 rounded-full blur-3xl pointer-events-none" style="background: radial-gradient(circle, rgba(0,212,255,0.05) 0%, transparent 70%);"></div>
      <div class="absolute bottom-0 left-0 right-0 h-px" style="background: linear-gradient(90deg, transparent, rgba(255,215,0,0.5), transparent); box-shadow: 0 0 8px rgba(255,215,0,0.3);"></div>

      <div class="relative z-10">
        <!-- Badge -->
        <div class="inline-flex items-center gap-3 px-5 py-2 mb-8" style="background: rgba(0,0,0,0.8); border: 1px solid rgba(255,215,0,0.4); box-shadow: 0 0 20px rgba(255,215,0,0.1);">
          <div class="relative">
            <div class="w-2 h-2 rounded-full animate-pulse" style="background: #00d4ff; box-shadow: 0 0 6px #00d4ff;"></div>
            <div class="absolute inset-0 w-2 h-2 rounded-full animate-ping opacity-60" style="background: #00d4ff;"></div>
          </div>
          <span class="text-xs font-black tracking-widest uppercase" style="color: #FFD700; font-family: 'Cinzel', serif; letter-spacing: 0.15em; text-shadow: 0 0 8px rgba(255,215,0,0.6);">
            ⬡ Respuesta en menos de 24h ⬡
          </span>
        </div>

        <!-- Título -->
        <h1 class="font-black mb-6" style="font-family: 'Cinzel Decorative', serif; font-size: clamp(2.5rem, 8vw, 6rem); letter-spacing: 0.05em; line-height: 1;">
          <span class="text-white">CONTÁCTAME</span>
          <div class="w-full h-px mt-3" style="background: linear-gradient(90deg, transparent, #FFD700, transparent); box-shadow: 0 0 8px rgba(255,215,0,0.5);"></div>
        </h1>

        <p class="text-gray-500 text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
          Si buscas <span style="color: #FFD700; font-weight: 700; text-shadow: 0 0 6px rgba(255,215,0,0.5);">colaborar en proyectos</span> o
          <span style="color: #00d4ff; font-weight: 700; text-shadow: 0 0 6px rgba(0,212,255,0.5);">trabajar juntos</span>,
          envíame un mensaje.
        </p>
      </div>
    </section>

    <!-- ── FORM + INFO ────────────────────────────────── -->
    <section class="relative py-16 px-4 md:px-6 overflow-hidden">
      <div class="absolute inset-0" style="background: rgba(0,0,0,0.50);">
        <div class="absolute inset-0 gotham-grid opacity-30"></div>
      </div>

      <div class="max-w-6xl mx-auto relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">

          <!-- INFO DE CONTACTO -->
          <div class="relative">
            <div class="absolute top-0 left-0 right-0 h-0.5" style="background: linear-gradient(90deg, transparent, #FFD700, transparent);"></div>
            <div class="p-6 md:p-8" style="background: rgba(0,0,0,0.9); border: 1px solid rgba(255,215,0,0.25); box-shadow: 0 4px 30px rgba(0,0,0,0.9), inset 0 0 30px rgba(255,215,0,0.02);">

              <h2 class="font-black mb-8 flex items-center gap-3" style="font-family: 'Cinzel Decorative', serif; font-size: clamp(1.3rem, 3vw, 2rem); letter-spacing: 0.06em; color: #FFD700; text-shadow: 0 0 20px rgba(255,215,0,0.6);">
                <span class="inline-block w-1 h-8" style="background: #FFD700; box-shadow: 0 0 8px rgba(255,215,0,0.8);"></span>
                Información de <span class="text-white ml-2">Contacto</span>
              </h2>

              <div class="space-y-4">
                <!-- Email -->
                <div class="flex items-center gap-4 p-4" style="background: rgba(255,215,0,0.03); border-left: 2px solid rgba(255,215,0,0.5); border: 1px solid rgba(255,215,0,0.1); border-left: 3px solid rgba(255,215,0,0.5);">
                  <div class="w-10 h-10 flex items-center justify-center flex-shrink-0" style="border: 1px solid rgba(255,215,0,0.4); background: rgba(255,215,0,0.05);">
                    <i class="fas fa-envelope text-sm" style="color: #FFD700; text-shadow: 0 0 6px rgba(255,215,0,0.7);"></i>
                  </div>
                  <div>
                    <p class="text-xs font-black tracking-widest uppercase mb-0.5" style="color: #6b7280; font-family: 'Cinzel', serif; font-size: 0.55rem; letter-spacing: 0.15em;">Correo Electrónico</p>
                    <p class="text-gray-200 font-medium text-sm">sdlv2882@gmail.com</p>
                  </div>
                </div>

                <!-- Teléfono -->
                <div class="flex items-center gap-4 p-4" style="background: rgba(0,212,255,0.03); border: 1px solid rgba(0,212,255,0.1); border-left: 3px solid rgba(0,212,255,0.5);">
                  <div class="w-10 h-10 flex items-center justify-center flex-shrink-0" style="border: 1px solid rgba(0,212,255,0.4); background: rgba(0,212,255,0.05);">
                    <i class="fas fa-phone-alt text-sm" style="color: #00d4ff; text-shadow: 0 0 6px rgba(0,212,255,0.7);"></i>
                  </div>
                  <div>
                    <p class="text-xs font-black tracking-widest uppercase mb-0.5" style="color: #6b7280; font-family: 'Cinzel', serif; font-size: 0.55rem; letter-spacing: 0.15em;">Teléfono</p>
                    <p class="text-gray-200 font-medium text-sm">+57 312 280 9604</p>
                  </div>
                </div>

                <!-- Ubicación -->
                <div class="flex items-center gap-4 p-4" style="background: rgba(139,92,246,0.03); border: 1px solid rgba(139,92,246,0.1); border-left: 3px solid rgba(139,92,246,0.5);">
                  <div class="w-10 h-10 flex items-center justify-center flex-shrink-0" style="border: 1px solid rgba(139,92,246,0.4); background: rgba(139,92,246,0.05);">
                    <i class="fas fa-map-marker-alt text-sm" style="color: #8b5cf6; text-shadow: 0 0 6px rgba(139,92,246,0.7);"></i>
                  </div>
                  <div>
                    <p class="text-xs font-black tracking-widest uppercase mb-0.5" style="color: #6b7280; font-family: 'Cinzel', serif; font-size: 0.55rem; letter-spacing: 0.15em;">Ubicación</p>
                    <p class="text-gray-200 font-medium text-sm">Disponible para trabajo remoto</p>
                  </div>
                </div>

                <!-- Tiempo respuesta -->
                <div class="flex items-center gap-4 p-4" style="background: rgba(255,215,0,0.03); border: 1px solid rgba(255,215,0,0.1); border-left: 3px solid rgba(255,215,0,0.5);">
                  <div class="w-10 h-10 flex items-center justify-center flex-shrink-0" style="border: 1px solid rgba(255,215,0,0.4); background: rgba(255,215,0,0.05);">
                    <i class="fas fa-clock text-sm" style="color: #FFD700; text-shadow: 0 0 6px rgba(255,215,0,0.7);"></i>
                  </div>
                  <div>
                    <p class="text-xs font-black tracking-widest uppercase mb-0.5" style="color: #6b7280; font-family: 'Cinzel', serif; font-size: 0.55rem; letter-spacing: 0.15em;">Tiempo de Respuesta</p>
                    <p class="text-gray-200 font-medium text-sm">Menos de 24 horas</p>
                  </div>
                </div>
              </div>

              <!-- Horario -->
              <div class="mt-8 pt-6" style="border-top: 1px solid rgba(255,215,0,0.1);">
                <h3 class="font-black mb-3 text-sm tracking-widest uppercase" style="color: #FFD700; font-family: 'Cinzel', serif; letter-spacing: 0.12em; text-shadow: 0 0 6px rgba(255,215,0,0.5);">Horario de Contacto</h3>
                <p class="text-gray-600 text-xs">Lun - Vie: 9:00 - 18:00 (GMT-5)</p>
                <p class="text-gray-600 text-xs mt-1" style="color: #00d4ff; opacity: 0.7;">Emergencias tecnológicas: Siempre disponible</p>
              </div>
            </div>
          </div>

          <!-- FORMULARIO -->
          <div class="relative">
            <div class="absolute top-0 left-0 right-0 h-0.5" style="background: linear-gradient(90deg, transparent, #00d4ff, transparent);"></div>
            <div class="p-6 md:p-8" style="background: rgba(0,0,0,0.9); border: 1px solid rgba(0,212,255,0.2); box-shadow: 0 4px 30px rgba(0,0,0,0.9), inset 0 0 30px rgba(0,212,255,0.02);">

              <!-- Terminal header -->
              <div class="flex items-center gap-2 mb-7 pb-4" style="border-bottom: 1px solid rgba(255,215,0,0.1);">
                <div class="w-2.5 h-2.5 rounded-full animate-pulse" style="background: #ff5f57;"></div>
                <div class="w-2.5 h-2.5 rounded-full" style="background: #FFD700;"></div>
                <div class="w-2.5 h-2.5 rounded-full" style="background: #00d4ff;"></div>
                <h3 class="font-black ml-3 text-sm tracking-widest uppercase" style="color: #FFD700; font-family: 'Cinzel', serif; letter-spacing: 0.12em;">ENVÍO DE MENSAJE</h3>
              </div>

              <form class="space-y-5" id="contactForm">
                <!-- Nombre -->
                <div>
                  <label for="name" class="block mb-2 text-xs font-black tracking-widest uppercase" style="color: #FFD700; font-family: 'Cinzel', serif; font-size: 0.6rem; letter-spacing: 0.15em;">
                    <i class="fas fa-user mr-2" style="color: #FFD700;"></i>NOMBRE
                  </label>
                  <input
                    id="name"
                    type="text"
                    placeholder="Ingresa tu nombre"
                    required
                    class="w-full p-3.5 text-sm text-white outline-none transition-all duration-300 contact-input"
                    style="background: rgba(0,0,0,0.8); border: 1px solid rgba(255,215,0,0.2); color: #e5e7eb;"
                  />
                </div>

                <!-- Email -->
                <div>
                  <label for="email" class="block mb-2 text-xs font-black tracking-widest uppercase" style="color: #00d4ff; font-family: 'Cinzel', serif; font-size: 0.6rem; letter-spacing: 0.15em;">
                    <i class="fas fa-envelope mr-2" style="color: #00d4ff;"></i>CORREO ELECTRÓNICO
                  </label>
                  <input
                    id="email"
                    type="email"
                    placeholder="tu@correo.com"
                    required
                    class="w-full p-3.5 text-sm text-white outline-none transition-all duration-300 contact-input-cyan"
                    style="background: rgba(0,0,0,0.8); border: 1px solid rgba(0,212,255,0.2); color: #e5e7eb;"
                  />
                </div>

                <!-- Mensaje -->
                <div>
                  <label for="message" class="block mb-2 text-xs font-black tracking-widest uppercase" style="color: #8b5cf6; font-family: 'Cinzel', serif; font-size: 0.6rem; letter-spacing: 0.15em;">
                    <i class="fas fa-comment-alt mr-2" style="color: #8b5cf6;"></i>MENSAJE
                  </label>
                  <textarea
                    id="message"
                    rows="5"
                    placeholder="Describe tu proyecto o consulta..."
                    required
                    class="w-full p-3.5 text-sm text-white outline-none transition-all duration-300 resize-none contact-input-purple"
                    style="background: rgba(0,0,0,0.8); border: 1px solid rgba(139,92,246,0.2); color: #e5e7eb;"
                  ></textarea>
                </div>

                <!-- Botón enviar -->
                <button
                  type="submit"
                  class="w-full py-4 mt-2 relative overflow-hidden transition-all duration-300 hover:scale-[1.02] group"
                  style="background: linear-gradient(135deg, #FFD700 0%, #d97706 50%, #FFD700 100%); background-size: 200% 100%; border: 2px solid rgba(255,215,0,0.7); box-shadow: 0 0 20px rgba(255,215,0,0.4); font-family: 'Cinzel', serif; font-weight: 900; font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; color: #000;"
                  id="submitBtn"
                >
                  <span class="relative z-10 flex items-center justify-center gap-2" id="btnText">
                    <i class="fas fa-paper-plane text-xs"></i>ENVIAR MENSAJE
                  </span>
                  <div class="absolute inset-0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700" style="background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);"></div>
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── FAQ ───────────────────────────────────────── -->
    <section class="relative py-16 md:py-24 px-4 md:px-6 overflow-hidden">
      <div class="absolute inset-0" style="background: rgba(0,0,0,0.50);">
        <div class="absolute inset-0 gotham-grid opacity-40"></div>
      </div>
      <div class="absolute top-0 left-0 right-0 h-px" style="background: linear-gradient(90deg, transparent, rgba(255,215,0,0.4), transparent); box-shadow: 0 0 8px rgba(255,215,0,0.3);"></div>

      <div class="max-w-4xl mx-auto relative z-10">
        <!-- Header -->
        <div class="flex items-center justify-center gap-4 mb-6">
          <div class="flex-1 h-px" style="background: linear-gradient(90deg, transparent, rgba(255,215,0,0.3));"></div>
          <span style="color: #FFD700; font-size: 1.1rem; text-shadow: 0 0 12px rgba(255,215,0,0.9);">⬡</span>
          <div class="flex-1 h-px" style="background: linear-gradient(90deg, rgba(255,215,0,0.3), transparent);"></div>
        </div>
        <div class="text-center mb-4">
          <span class="text-xs font-black tracking-widest uppercase" style="color: #00d4ff; font-family: 'Cinzel', serif; letter-spacing: 0.2em; text-shadow: 0 0 8px rgba(0,212,255,0.7);">─── Dudas Frecuentes ───</span>
        </div>
        <h2 class="text-center font-black mb-12" style="font-family: 'Cinzel Decorative', serif; font-size: clamp(1.8rem, 5vw, 3rem); letter-spacing: 0.06em; line-height: 1.1;">
          <span class="text-white">PREGUNTAS </span>
          <span style="color: #FFD700; text-shadow: 0 0 25px rgba(255,215,0,0.7);">FRECUENTES</span>
        </h2>

        <div class="space-y-3">
          <!-- FAQ 1 -->
          <div class="faq-item">
            <button class="faq-question w-full text-left p-4 flex justify-between items-start gap-4">
              <div class="flex items-start gap-4">
                <div class="w-8 h-8 flex items-center justify-center flex-shrink-0" style="border: 1px solid rgba(255,215,0,0.4); background: rgba(255,215,0,0.05);">
                  <i class="fas fa-clock text-xs" style="color: #FFD700;"></i>
                </div>
                <div>
                  <span class="font-black text-sm block" style="color: #FFD700; font-family: 'Cinzel', serif; letter-spacing: 0.04em;">¿Cuánto tardas en responder?</span>
                  <span class="text-gray-600 text-xs block mt-0.5">Tiempo estimado de respuesta</span>
                </div>
              </div>
              <i class="fas fa-chevron-down text-xs mt-1 flex-shrink-0 transition-transform duration-300" style="color: #6b7280;"></i>
            </button>
            <div class="faq-answer">
              <p class="text-gray-500 text-sm p-4 pt-0 leading-relaxed">
                Normalmente respondo en menos de <span style="color: #FFD700; font-weight: 700;">24 horas hábiles</span>. Para consultas urgentes, respondo en menos de 6 horas.
              </p>
            </div>
          </div>

          <!-- FAQ 2 -->
          <div class="faq-item">
            <button class="faq-question w-full text-left p-4 flex justify-between items-start gap-4">
              <div class="flex items-start gap-4">
                <div class="w-8 h-8 flex items-center justify-center flex-shrink-0" style="border: 1px solid rgba(0,212,255,0.4); background: rgba(0,212,255,0.05);">
                  <i class="fas fa-globe-americas text-xs" style="color: #00d4ff;"></i>
                </div>
                <div>
                  <span class="font-black text-sm block" style="color: #FFD700; font-family: 'Cinzel', serif; letter-spacing: 0.04em;">¿Trabajas con empresas internacionales?</span>
                  <span class="text-gray-600 text-xs block mt-0.5">Alcance global</span>
                </div>
              </div>
              <i class="fas fa-chevron-down text-xs mt-1 flex-shrink-0 transition-transform duration-300" style="color: #6b7280;"></i>
            </button>
            <div class="faq-answer">
              <p class="text-gray-500 text-sm p-4 pt-0 leading-relaxed">
                Sí, trabajo con clientes de distintos países. Manejo <span style="color: #00d4ff; font-weight: 700;">múltiples husos horarios</span> y hablo español e inglés fluidamente.
              </p>
            </div>
          </div>

          <!-- FAQ 3 -->
          <div class="faq-item">
            <button class="faq-question w-full text-left p-4 flex justify-between items-start gap-4">
              <div class="flex items-start gap-4">
                <div class="w-8 h-8 flex items-center justify-center flex-shrink-0" style="border: 1px solid rgba(139,92,246,0.4); background: rgba(139,92,246,0.05);">
                  <i class="fas fa-tools text-xs" style="color: #8b5cf6;"></i>
                </div>
                <div>
                  <span class="font-black text-sm block" style="color: #FFD700; font-family: 'Cinzel', serif; letter-spacing: 0.04em;">¿Ofreces mantenimiento post-desarrollo?</span>
                  <span class="text-gray-600 text-xs block mt-0.5">Soporte continuo</span>
                </div>
              </div>
              <i class="fas fa-chevron-down text-xs mt-1 flex-shrink-0 transition-transform duration-300" style="color: #6b7280;"></i>
            </button>
            <div class="faq-answer">
              <p class="text-gray-500 text-sm p-4 pt-0 leading-relaxed">
                Sí, ofrezco <span style="color: #8b5cf6; font-weight: 700;">soporte post-desarrollo</span> con planes de mantenimiento que incluyen actualizaciones, corrección de bugs y optimizaciones.
              </p>
            </div>
          </div>

          <!-- FAQ 4 -->
          <div class="faq-item">
            <button class="faq-question w-full text-left p-4 flex justify-between items-start gap-4">
              <div class="flex items-start gap-4">
                <div class="w-8 h-8 flex items-center justify-center flex-shrink-0" style="border: 1px solid rgba(255,215,0,0.4); background: rgba(255,215,0,0.05);">
                  <i class="fas fa-shield-alt text-xs" style="color: #FFD700;"></i>
                </div>
                <div>
                  <span class="font-black text-sm block" style="color: #FFD700; font-family: 'Cinzel', serif; letter-spacing: 0.04em;">¿Cómo manejas la confidencialidad?</span>
                  <span class="text-gray-600 text-xs block mt-0.5">Seguridad y privacidad</span>
                </div>
              </div>
              <i class="fas fa-chevron-down text-xs mt-1 flex-shrink-0 transition-transform duration-300" style="color: #6b7280;"></i>
            </button>
            <div class="faq-answer">
              <p class="text-gray-500 text-sm p-4 pt-0 leading-relaxed">
                Trabajo con <span style="color: #FFD700; font-weight: 700;">estrictos protocolos de confidencialidad</span>. Ofrezco firmar NDAs y utilizo encriptación para todas las comunicaciones y datos sensibles.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Layout>

<style is:global>
  /* Input focus effects */
  .contact-input:focus {
    border-color: rgba(255,215,0,0.6) !important;
    box-shadow: 0 0 15px rgba(255,215,0,0.15), inset 0 0 10px rgba(255,215,0,0.03) !important;
  }
  .contact-input-cyan:focus {
    border-color: rgba(0,212,255,0.6) !important;
    box-shadow: 0 0 15px rgba(0,212,255,0.15), inset 0 0 10px rgba(0,212,255,0.03) !important;
  }
  .contact-input-purple:focus {
    border-color: rgba(139,92,246,0.6) !important;
    box-shadow: 0 0 15px rgba(139,92,246,0.15), inset 0 0 10px rgba(139,92,246,0.03) !important;
  }

  /* Prevent zoom on iOS */
  .contact-input, .contact-input-cyan, .contact-input-purple { font-size: 16px; }
  @media (max-width: 640px) {
    .contact-input, .contact-input-cyan, .contact-input-purple { font-size: 14px; }
  }

  /* FAQ */
  .faq-item {
    background: rgba(0,0,0,0.8);
    border: 1px solid rgba(255,215,0,0.12);
    overflow: hidden;
    transition: all 0.3s ease;
  }
  .faq-item:hover { border-color: rgba(255,215,0,0.25); box-shadow: 0 0 15px rgba(255,215,0,0.05); }
  .faq-item.active { border-color: rgba(255,215,0,0.35); }

  .faq-question {
    background: transparent;
    color: #e5e7eb;
    cursor: pointer;
    border: none;
    transition: background 0.3s ease;
  }
  .faq-question:hover { background: rgba(255,215,0,0.03); }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .faq-item.active .faq-answer {
    max-height: 200px;
    border-top: 1px solid rgba(255,215,0,0.08);
  }
  .faq-item.active .fa-chevron-down { transform: rotate(180deg); color: #FFD700 !important; }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    // Form submit → Gmail
    const contactForm = document.getElementById("contactForm");
    if (contactForm) {
      contactForm.addEventListener("submit", function (event) {
        event.preventDefault();

        const name = document.getElementById("name").value;
        const email = document.getElementById("email").value;
        const message = document.getElementById("message").value;

        const subject = `Contacto desde portfolio - ${name}`;
        const body = `Hola Santiago,\n\nMe pongo en contacto contigo desde tu portfolio.\n\nNombre: ${name}\nCorreo de respuesta: ${email}\n\nMensaje:\n${message}`;
        const gmailURL = `https://mail.google.com/mail/u/0/?view=cm&to=sdlv2882@gmail.com&su=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

        const submitBtn = document.getElementById("submitBtn");
        const btnText = document.getElementById("btnText");

        if (submitBtn && btnText) {
          btnText.innerHTML = '<i class="fas fa-spinner fa-spin mr-2 text-xs"></i>ENVIANDO...';
          submitBtn.disabled = true;
        }

        window.open(gmailURL, "_blank");

        setTimeout(() => {
          contactForm.reset();
          if (submitBtn && btnText) {
            btnText.innerHTML = '<i class="fas fa-paper-plane text-xs mr-2"></i>ENVIAR MENSAJE';
            submitBtn.disabled = false;
          }
          alert("¡Se abrió Gmail con tu mensaje listo para enviar! Gracias por contactarme.");
        }, 1000);
      });
    }

    // FAQ toggle
    document.querySelectorAll(".faq-question").forEach((btn) => {
      btn.addEventListener("click", () => {
        const item = btn.closest(".faq-item");
        document.querySelectorAll(".faq-item").forEach((i) => { if (i !== item) i.classList.remove("active"); });
        item.classList.toggle("active");
      });
    });
  });
</script>
