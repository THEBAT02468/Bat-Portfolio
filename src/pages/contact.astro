---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackgroundAnimation from "../components/BackgroundAnimation.astro";
import WaterDrops from "../components/WaterDrops.astro";
import Smoke from "../components/Smoke.astro";

// Simular envío de formulario
const handleSubmit = (event) => {
  event.preventDefault();
  alert("¡Mensaje enviado! Te contactaré pronto desde Gotham.");
};
---

<Layout
  title="Contacto - Gotham Style"
  description="Contacta con Santiago López, desarrollador de software con estilo Gótico inspirado en Batman para colaborar en proyectos"
>
  <!-- Capas visuales (NO deben capturar clicks) -->
  <Smoke />
  <BackgroundAnimation />
  
  <div class="relative z-10">
    <WaterDrops />
    <Header />

    <!-- HERO CON EFECTO BAT-SEÑAL -->
    <section class="relative min-h-screen flex flex-col justify-center items-center text-center px-6 py-20 mt-20 overflow-hidden">
      <!-- Efecto Bat-señal en el fondo -->
      <div class="absolute top-0 left-1/2 transform -translate-x-1/2 w-96 h-96 opacity-10">
        <div class="absolute inset-0 bg-gradient-to-b from-yellow-400 to-transparent rounded-full blur-3xl"></div>
      </div>
      
      <!-- Logo Batman sutil -->
      <div class="absolute top-10 right-10 opacity-5">
        <svg class="w-64 h-64" viewBox="0 0 24 24" fill="none">
          <path d="M12 2L2 7V12C2 17.5 6 22 12 22C18 22 22 17.5 22 12V7L12 2Z" stroke="currentColor" stroke-width="1"/>
          <path d="M12 8L8 11H12V15H16V11L12 8Z" stroke="currentColor" stroke-width="1"/>
        </svg>
      </div>

      <h1 class="text-6xl md:text-8xl font-bold text-yellow-400 mb-6 font-batman relative z-20 tracking-tight">
        CONTÁCTAME
        <div class="absolute -bottom-2 left-0 w-full h-1 bg-gradient-to-r from-transparent via-yellow-400 to-transparent"></div>
      </h1>

      <p class="text-xl md:text-2xl text-gray-300 mb-10 max-w-2xl relative z-20 leading-relaxed">
        Si buscas <span class="text-yellow-400 font-semibold">colaborar en proyectos oscuros</span> o 
        <span class="text-yellow-400 font-semibold">trabajar desde las sombras</span>, envíame un mensaje.
      </p>

      <div class="grid md:grid-cols-2 gap-12 max-w-6xl w-full items-start relative z-20">
        <!-- INFO DE CONTACTO - ESTILO TABLILLA GÓTICA -->
        <div class="contact-info text-left relative">
          <div class="absolute -inset-1 bg-gradient-to-r from-gray-900 via-yellow-600 to-gray-900 rounded-lg blur opacity-30"></div>
          <div class="relative p-8 bg-gray-900 border border-yellow-800 rounded-lg shadow-2xl shadow-black/50">
            <h2 class="text-3xl md:text-4xl text-yellow-400 mb-8 font-batman flex items-center gap-3">
              <span class="inline-block w-3 h-8 bg-yellow-400"></span>
              Información de <span class="text-white">Contacto</span>
            </h2>

            <div class="space-y-6">
              <div class="flex items-center gap-4 p-3 bg-gray-800/50 rounded-lg border-l-4 border-yellow-600">
                <div class="bg-yellow-900/30 p-2 rounded">
                  <i class="fas fa-envelope text-yellow-400"></i>
                </div>
                <div>
                  <p class="text-gray-400 text-sm">Correo Electrónico</p>
                  <p class="text-gray-300 font-medium">sdlv2882@gmail.com</p>
                </div>
              </div>

              <div class="flex items-center gap-4 p-3 bg-gray-800/50 rounded-lg border-l-4 border-yellow-600">
                <div class="bg-yellow-900/30 p-2 rounded">
                  <i class="fas fa-phone-alt text-yellow-400"></i>
                </div>
                <div>
                  <p class="text-gray-400 text-sm">Número de teléfono</p>
                  <p class="text-gray-300 font-medium">+57 312 280 9604</p>
                </div>
              </div>


              <div class="flex items-center gap-4 p-3 bg-gray-800/50 rounded-lg border-l-4 border-yellow-600">
                <div class="bg-yellow-900/30 p-2 rounded">
                  <i class="fas fa-map-marker-alt text-yellow-400"></i>
                </div>
                <div>
                  <p class="text-gray-400 text-sm">Ubicación</p>
                  <p class="text-gray-300 font-medium">Disponible para trabajo remoto</p>
                </div>
              </div>

              <div class="flex items-center gap-4 p-3 bg-gray-800/50 rounded-lg border-l-4 border-yellow-600">
                <div class="bg-yellow-900/30 p-2 rounded">
                  <i class="fas fa-clock text-yellow-400"></i>
                </div>
                <div>
                  <p class="text-gray-400 text-sm">Tiempo de Respuesta</p>
                  <p class="text-gray-300 font-medium">Menos de 24 horas</p>
                </div>
              </div>
            </div>

            <div class="mt-10 pt-8 border-t border-gray-800">
              <h3 class="text-xl text-yellow-400 mb-4">Horario de Contacto</h3>
              <p class="text-gray-400">Lun - Vie: 9:00 - 18:00 (GMT-5)</p>
              <p class="text-gray-400 text-sm mt-2">Emergencias tecnológicas: Siempre disponible</p>
            </div>
          </div>
        </div>

        <!-- FORMULARIO - ESTILO BATCOMPUTADORA -->
        <div class="contact-form relative">
          <div class="absolute -inset-1 bg-gradient-to-r from-yellow-900 via-gray-900 to-yellow-900 rounded-lg blur opacity-30"></div>
          <div class="relative card-bat p-8 border-2 border-yellow-800 bg-gradient-to-br from-gray-900 to-black rounded-lg shadow-2xl shadow-black">
            <div class="flex items-center gap-3 mb-8 pb-4 border-b border-yellow-800">
              <div class="w-3 h-3 bg-red-500 rounded-full animate-pulse"></div>
              <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
              <div class="w-3 h-3 bg-green-500 rounded-full"></div>
              <h3 class="text-2xl text-yellow-400 ml-4 font-batman">ENVÍO DE MENSAJE</h3>
            </div>

            <form class="space-y-6" on:submit={handleSubmit}>
              <div class="relative">
                <label for="name" class="block text-yellow-400 mb-2 text-sm font-medium">
                  <i class="fas fa-user mr-2"></i>NOMBRE
                </label>
                <input
                  id="name"
                  type="text"
                  placeholder="Ingresa tu nombre"
                  required
                  class="w-full p-4 bg-gray-900 text-white rounded-lg border border-gray-700 focus:border-yellow-500 focus:ring-2 focus:ring-yellow-500/30 focus:outline-none transition-all"
                />
              </div>

              <div class="relative">
                <label for="email" class="block text-yellow-400 mb-2 text-sm font-medium">
                  <i class="fas fa-envelope mr-2"></i>CORREO ELECTRÓNICO
                </label>
                <input
                  id="email"
                  type="email"
                  placeholder="tu@correo.com"
                  required
                  class="w-full p-4 bg-gray-900 text-white rounded-lg border border-gray-700 focus:border-yellow-500 focus:ring-2 focus:ring-yellow-500/30 focus:outline-none transition-all"
                />
              </div>

              <div class="relative">
                <label for="message" class="block text-yellow-400 mb-2 text-sm font-medium">
                  <i class="fas fa-comment-alt mr-2"></i>MENSAJE
                </label>
                <textarea
                  id="message"
                  rows="5"
                  placeholder="Describe tu proyecto o consulta..."
                  required
                  class="w-full p-4 bg-gray-900 text-white rounded-lg border border-gray-700 focus:border-yellow-500 focus:ring-2 focus:ring-yellow-500/30 focus:outline-none transition-all resize-none"
                ></textarea>
              </div>

              <button type="submit" class="w-full btn-bat py-4 mt-8 relative overflow-hidden group">
                <span class="relative z-10 font-batman text-lg tracking-wider">
                  <i class="fas fa-paper-plane mr-2"></i>ENVIAR MENSAJE
                </span>
                <div class="absolute inset-0 bg-gradient-to-r from-yellow-600 via-yellow-700 to-yellow-600 group-hover:from-yellow-500 group-hover:via-yellow-600 group-hover:to-yellow-500 transition-all duration-300"></div>
                <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-1000"></div>
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ - ESTILO ARCHIVOS GCPD -->
    <section class="relative py-24 px-6 bg-gradient-to-b from-gray-900 via-black to-gray-900">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width="100" height="100" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"%3E%3Cpath d="M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z" fill="%23f1c40f" fill-opacity="0.4" fill-rule="evenodd"/%3E%3C/svg%3E');"></div>
      </div>
      
      <div class="max-w-5xl mx-auto relative">
        <h2 class="text-4xl md:text-5xl text-center text-yellow-400 mb-20 font-batman relative">
          <span class="relative inline-block">
            PREGUNTAS <span class="text-white">FRECUENTES</span>
            <div class="absolute -bottom-4 left-1/4 right-1/4 h-1 bg-gradient-to-r from-yellow-600 via-yellow-400 to-yellow-600"></div>
          </span>
        </h2>

        <div class="space-y-4">
          <!-- ITEM FAQ -->
          <div class="faq-item group">
            <button class="faq-question group-hover:bg-gray-900/50 transition-all duration-300">
              <div class="flex items-center gap-4">
                <div class="w-8 h-8 flex items-center justify-center bg-yellow-900/30 rounded">
                  <i class="fas fa-clock text-yellow-400"></i>
                </div>
                <span class="text-left">
                  <span class="text-yellow-400 font-medium">¿Cuánto tiempo tardas en responder?</span>
                  <span class="block text-gray-400 text-sm font-normal">Tiempo estimado de respuesta</span>
                </span>
              </div>
              <i class="fas fa-chevron-down transition-transform duration-300"></i>
            </button>
            <div class="faq-answer">
              <p class="text-gray-300">Normalmente respondo en menos de <span class="text-yellow-400">24 horas hábiles</span>. Para consultas urgentes, marco el mensaje como prioridad y respondo en menos de 6 horas.</p>
            </div>
          </div>

          <div class="faq-item group">
            <button class="faq-question group-hover:bg-gray-900/50 transition-all duration-300">
              <div class="flex items-center gap-4">
                <div class="w-8 h-8 flex items-center justify-center bg-yellow-900/30 rounded">
                  <i class="fas fa-globe-americas text-yellow-400"></i>
                </div>
                <span class="text-left">
                  <span class="text-yellow-400 font-medium">¿Trabajas con empresas internacionales?</span>
                  <span class="block text-gray-400 text-sm font-normal">Alcance global</span>
                </span>
              </div>
              <i class="fas fa-chevron-down transition-transform duration-300"></i>
            </button>
            <div class="faq-answer">
              <p class="text-gray-300">Sí, trabajo con clientes de distintos países. Manejo <span class="text-yellow-400">múltiples husos horarios</span> y me adapto a las necesidades internacionales. Hablo español e inglés fluidamente.</p>
            </div>
          </div>

          <div class="faq-item group">
            <button class="faq-question group-hover:bg-gray-900/50 transition-all duration-300">
              <div class="flex items-center gap-4">
                <div class="w-8 h-8 flex items-center justify-center bg-yellow-900/30 rounded">
                  <i class="fas fa-tools text-yellow-400"></i>
                </div>
                <span class="text-left">
                  <span class="text-yellow-400 font-medium">¿Ofreces mantenimiento post-desarrollo?</span>
                  <span class="block text-gray-400 text-sm font-normal">Soporte continuo</span>
                </span>
              </div>
              <i class="fas fa-chevron-down transition-transform duration-300"></i>
            </button>
            <div class="faq-answer">
              <p class="text-gray-300">Sí, ofrezco <span class="text-yellow-400">soporte post-desarrollo</span> con diferentes planes de mantenimiento. Esto incluye actualizaciones, corrección de bugs, optimizaciones y monitoreo del proyecto.</p>
            </div>
          </div>

          <div class="faq-item group">
            <button class="faq-question group-hover:bg-gray-900/50 transition-all duration-300">
              <div class="flex items-center gap-4">
                <div class="w-8 h-8 flex items-center justify-center bg-yellow-900/30 rounded">
                  <i class="fas fa-shield-alt text-yellow-400"></i>
                </div>
                <span class="text-left">
                  <span class="text-yellow-400 font-medium">¿Cómo manejas la confidencialidad?</span>
                  <span class="block text-gray-400 text-sm font-normal">Seguridad y privacidad</span>
                </span>
              </div>
              <i class="fas fa-chevron-down transition-transform duration-300"></i>
            </button>
            <div class="faq-answer">
              <p class="text-gray-300">Trabajo con <span class="text-yellow-400">estrictos protocolos de confidencialidad</span>. Ofrezco firmar NDAs y utilizo encriptación para todas las comunicaciones y datos sensibles.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Layout>

<style>
/* 🔒 CLAVE: capas visuales NO capturan clicks */
.smoke,
.background-animation,
.water-drops {
  pointer-events: none !important;
}

/* Fuente Batman */
.font-batman {
  font-family: 'Cinzel', serif;
  letter-spacing: 0.05em;
}

/* FAQ Mejorado */
.faq-item {
  border: 1px solid rgba(241, 196, 15, 0.2);
  border-radius: 0.75rem;
  overflow: hidden;
  background: rgba(17, 24, 39, 0.6);
  backdrop-filter: blur(10px);
  transition: all 0.3s ease;
}

.faq-item:hover {
  border-color: rgba(241, 196, 15, 0.4);
  box-shadow: 0 0 20px rgba(241, 196, 15, 0.1);
}

.faq-question {
  width: 100%;
  padding: 1.5rem 2rem;
  background: transparent;
  color: #f1c40f;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  border: none;
  transition: all 0.3s ease;
}

.faq-question:hover {
  background: rgba(30, 41, 59, 0.4);
}

.faq-answer {
  max-height: 0;
  overflow: hidden;
  padding: 0 2rem;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.faq-item.active .faq-answer {
  max-height: 500px;
  padding: 1rem 2rem 2rem;
  border-top: 1px solid rgba(241, 196, 15, 0.1);
}

.faq-item.active .fa-question {
  color: #f59e0b;
}

.faq-item.active i.fa-chevron-down {
  transform: rotate(180deg);
}

/* Estilos de botón mejorados */
.btn-bat {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: white;
  border: none;
  border-radius: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.btn-bat:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(245, 158, 11, 0.3);
}

/* Efectos de borde luminoso */
.card-bat {
  position: relative;
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid rgba(251, 191, 36, 0.3);
  border-radius: 1rem;
  overflow: hidden;
}

.card-bat::before {
  content: '';
  position: absolute;
  top: -2px;
  left: -2px;
  right: -2px;
  bottom: -2px;
  background: linear-gradient(45deg, #fbbf24, #92400e, #fbbf24);
  border-radius: 1rem;
  z-index: -1;
  opacity: 0.3;
  animation: borderGlow 3s linear infinite;
}

@keyframes borderGlow {
  0%, 100% {
    opacity: 0.2;
  }
  50% {
    opacity: 0.4;
  }
}

/* Efecto de máquina de escribir */
.typewriter {
  overflow: hidden;
  border-right: 3px solid #fbbf24;
  white-space: nowrap;
  animation: typing 3.5s steps(40, end), blink-caret 0.75s step-end infinite;
}

@keyframes typing {
  from { width: 0 }
  to { width: 100% }
}

@keyframes blink-caret {
  from, to { border-color: transparent }
  50% { border-color: #fbbf24 }
}

/* Scroll personalizado */
::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-track {
  background: #111827;
}

::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, #f59e0b, #92400e);
  border-radius: 5px;
}

::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(180deg, #fbbf24, #b45309);
}
</style>

<script is:inline>
  document.querySelectorAll(".faq-question").forEach(btn => {
    btn.addEventListener("click", () => {
      const item = btn.closest(".faq-item");
      
      // Cerrar otros items
      document.querySelectorAll(".faq-item").forEach(i => {
        if (i !== item) {
          i.classList.remove("active");
          i.querySelector('i.fa-chevron-down').style.transform = 'rotate(0deg)';
        }
      });

      // Alternar item actual
      const isActive = item.classList.contains("active");
      item.classList.toggle("active");
      
      // Animación suave del ícono
      const icon = btn.querySelector('i.fa-chevron-down');
      if (isActive) {
        icon.style.transform = 'rotate(0deg)';
      } else {
        icon.style.transform = 'rotate(180deg)';
      }
    });
  });

  // Efecto hover en inputs
  document.querySelectorAll('input, textarea').forEach(input => {
    input.addEventListener('focus', function() {
      this.parentElement.classList.add('focused');
    });
    
    input.addEventListener('blur', function() {
      this.parentElement.classList.remove('focused');
    });
  });

  // Efecto de carga en botón de envío
  const submitButton = document.querySelector('button[type="submit"]');
  if (submitButton) {
    submitButton.addEventListener('click', function(e) {
      if (this.form.checkValidity()) {
        this.classList.add('sending');
        setTimeout(() => {
          this.classList.remove('sending');
        }, 2000);
      }
    });
  }
</script>