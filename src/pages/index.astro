<style is:global>
  /* Animaciones mejoradas */
  @keyframes bounce {
    0%,
    20%,
    50%,
    80%,
    100% {
      transform: translateY(0) translateX(-50%);
    }
    40% {
      transform: translateY(-10px) translateX(-50%);
    }
    60% {
      transform: translateY(-5px) translateX(-50%);
    }
  }

  @keyframes gradient {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  @keyframes gradient-slow {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .animate-bounce {
    animation: bounce 2s infinite;
  }

  /* ── Hero right column ───────────────────────── */

  /* Marco angular estilo Gotham — cortes diagonales en las 4 esquinas */
  .hero-img-frame {
    clip-path: polygon(
      6% 0%, 100% 0%,
      100% 94%, 94% 100%,
      0% 100%, 0% 6%
    );
    animation: heroSlideIn 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* Borde neón que sigue el mismo clip-path */
  .hero-glow-border {
    position: absolute;
    inset: -2px;
    z-index: 5;
    pointer-events: none;
    clip-path: polygon(
      6% 0%, 100% 0%,
      100% 94%, 94% 100%,
      0% 100%, 0% 6%
    );
    background: linear-gradient(
      135deg,
      rgba(255, 215, 0, 0.55) 0%,
      rgba(0, 212, 255, 0.30) 40%,
      rgba(255, 215, 0, 0.55) 100%
    );
    filter: blur(2px);
    animation: heroSlideIn 1.1s cubic-bezier(0.22, 1, 0.36, 1) both,
               borderPulse 4s ease-in-out 1.1s infinite;
  }

  /* Ken Burns sutil en la imagen */
  .hero-img {
    animation: kenBurns 12s ease-in-out infinite alternate;
    transform-origin: center top;
  }

  /* Fuente.png: aparece desde abajo con desenfoque */
  .fuente-img {
    animation: fuenFeIn 1s cubic-bezier(0.22, 1, 0.36, 1) 0.7s both;
  }

  @keyframes heroSlideIn {
    from {
      opacity: 0;
      transform: translateX(50px);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
      filter: blur(0);
    }
  }

  @keyframes kenBurns {
    from { transform: scale(1.00) translateY(0px); }
    to   { transform: scale(1.05) translateY(-8px); }
  }

  @keyframes fuenFeIn {
    from {
      opacity: 0;
      transform: translateY(28px);
      filter: blur(8px) drop-shadow(0 0 0 rgba(255,215,0,0));
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: drop-shadow(0 0 24px rgba(255,215,0,0.7)) drop-shadow(0 0 8px rgba(0,0,0,1));
    }
  }

  @keyframes borderPulse {
    0%, 100% { opacity: 0.7; filter: blur(2px); }
    50%       { opacity: 1.0; filter: blur(3px); }
  }

  .animate-gradient {
    background-size: 200% auto;
    animation: gradient 4s ease-in-out infinite;
  }

  .animate-gradient-slow {
    background-size: 200% auto;
    animation: gradient-slow 8s ease-in-out infinite;
  }

  /* Animación de progreso */
  @keyframes progress {
    from {
      width: 0;
    }
  }

  .progress-bar {
    animation: progress 1.5s ease-out forwards;
  }

  /* Scrollbar gold LEGO Batman */
  ::-webkit-scrollbar {
    width: 6px;
  }

  ::-webkit-scrollbar-track {
    background: #000;
  }

  ::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, #FFD700, #d97706);
    border-radius: 3px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg, #fff700, #FFD700);
    box-shadow: 0 0 8px rgba(255,215,0,0.8);
  }

  /* Mejoras generales de tipografía */
  body {
    font-feature-settings:
      "kern" 1,
      "liga" 1,
      "calt" 1;
  }

  /* Optimizaciones para móvil */
  @media (max-width: 640px) {
    input,
    textarea,
    button,
    select {
      font-size: 16px;
    }

    a,
    button {
      min-height: 44px;
      min-width: 44px;
    }

    /* Reducir efectos en móvil para mejor performance */
    .backdrop-blur-xl {
      backdrop-filter: blur(8px);
    }

    .blur-3xl {
      filter: blur(16px);
    }
  }

  /* Transiciones suaves */
  * {
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  /* Mejorar contraste para legibilidad */
  .text-overlay {
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
  }

  /* Efectos de brillo sutil */
  .glow-effect {
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.1);
  }

  .glow-effect:hover {
    box-shadow: 0 0 30px rgba(59, 130, 246, 0.2);
  }

  /* Gradientes mejorados */
  .gradient-border {
    position: relative;
    background:
      linear-gradient(#0f172a, #0f172a) padding-box,
      linear-gradient(45deg, #3b82f6, #10b981) border-box;
    border: 1px solid transparent;
  }

  /* Mejoras de accesibilidad */
  @media (prefers-reduced-motion: reduce) {
    .animate-bounce,
    .animate-gradient,
    .animate-gradient-slow,
    .progress-bar,
    .transition-all {
      animation: none;
      transition: none;
    }
  }

  /* Ajustes específicos para WaterDrops */
  .water-drops-overlay {
    pointer-events: none;
    mix-blend-mode: screen;
    opacity: 0.3;
  }

  /* Mejorar rendimiento en móvil */
  @media (max-width: 768px) {
    .transform {
      will-change: transform;
    }

    .backdrop-blur-xl {
      backdrop-filter: blur(4px);
    }
  }

  /* Sombra de texto para mejor legibilidad */
  .text-shadow {
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
  }

  /* Efecto de vidrio esmerilado mejorado */
  .glass-morphism {
    background: rgba(17, 24, 39, 0.7);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    // Animación de barras de progreso con Intersection Observer
    const progressObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const progressBars = entry.target.querySelectorAll(".progress-bar");
            progressBars.forEach((bar) => {
              if (!bar.dataset.animated) {
                bar.style.animation = "none";
                bar.offsetHeight; // Trigger reflow
                bar.style.animation = "progress 1.5s ease-out forwards";
                bar.dataset.animated = "true";
              }
            });
          }
        });
      },
      { threshold: 0.2 },
    );

    // Observar sección de tecnologías
    const techSection = document.querySelector("section:nth-of-type(2)");
    if (techSection) progressObserver.observe(techSection);

    // Smooth scroll mejorado
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener("click", function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute("href"));
        if (target) {
          const offset = window.innerWidth <= 768 ? 80 : 120;
          const targetPosition =
            target.getBoundingClientRect().top + window.pageYOffset - offset;

          window.scrollTo({
            top: targetPosition,
            behavior: "smooth",
          });
        }
      });
    });

    // Mejorar experiencia táctil
    if ("ontouchstart" in window) {
      // Feedback táctil para todos los elementos interactivos
      const addTouchFeedback = (element) => {
        element.addEventListener("touchstart", function () {
          this.style.transform = "scale(0.98)";
          this.style.opacity = "0.9";
        });

        element.addEventListener("touchend", function () {
          this.style.transform = "";
          this.style.opacity = "";
        });

        element.addEventListener("touchcancel", function () {
          this.style.transform = "";
          this.style.opacity = "";
        });
      };

      document.querySelectorAll("a, button, .group").forEach(addTouchFeedback);
    }

    // Scroll-fade para la columna derecha del hero
    // (Background.png + Fuente.png se desvanecen al hacer scroll)
    const heroRightCol = document.getElementById("hero-right-col");
    const heroSection  = document.querySelector("section");

    if (heroRightCol && heroSection) {
      let rafHero = false;

      window.addEventListener("scroll", function () {
        if (rafHero) return;
        rafHero = true;
        requestAnimationFrame(function () {
          const heroH    = heroSection.offsetHeight;
          const scrollY  = window.pageYOffset;
          const fadeFrom = heroH * 0.30; // empieza a desvanecerse
          const fadeTo   = heroH * 0.75; // totalmente invisible

          let opacity   = 1;
          let translateY = 0;

          if (scrollY > fadeFrom) {
            const progress = Math.min(1, (scrollY - fadeFrom) / (fadeTo - fadeFrom));
            opacity    = 1 - progress;
            translateY = -progress * 40; // sube ligeramente al perderse
          }

          heroRightCol.style.opacity   = opacity;
          heroRightCol.style.transform = `translateY(${translateY}px)`;
          rafHero = false;
        });
      }, { passive: true });
    }

    // Optimización para diferentes conexiones
    if ("connection" in navigator) {
      const connection = navigator.connection;
      const isSlowConnection =
        connection.saveData ||
        connection.effectiveType.includes("2g") ||
        connection.effectiveType.includes("slow-2g");

      if (isSlowConnection) {
        // Reducir efectos visuales
        document
          .querySelectorAll(".blur-3xl, .backdrop-blur-xl")
          .forEach((el) => {
            el.style.filter = "blur(8px)";
            el.style.backdropFilter = "blur(4px)";
          });

        // Deshabilitar animaciones pesadas
        document
          .querySelectorAll(".animate-gradient, .animate-gradient-slow")
          .forEach((el) => {
            el.style.animation = "none";
          });
      }
    }

    // Lazy loading para imágenes
    const imageObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const img = entry.target;
            if (img.dataset.src) {
              img.src = img.dataset.src;
              img.removeAttribute("data-src");
            }
            imageObserver.unobserve(img);
          }
        });
      },
      { threshold: 0.1 },
    );

    document.querySelectorAll("img[data-src]").forEach((img) => {
      imageObserver.observe(img);
    });

    // Efecto de aparición gradual para elementos
    const fadeObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.style.opacity = "1";
            entry.target.style.transform = "translateY(0)";
          }
        });
      },
      { threshold: 0.1 },
    );

    // Aplicar estilos iniciales para animación
    document.querySelectorAll("section > *").forEach((el) => {
      el.style.opacity = "0";
      el.style.transform = "translateY(20px)";
      el.style.transition = "opacity 0.6s ease, transform 0.6s ease";
      fadeObserver.observe(el);
    });

    // Prevenir zoom en inputs en iOS
    let lastTouchEnd = 0;
    document.addEventListener(
      "touchend",
      function (event) {
        const now = new Date().getTime();
        if (now - lastTouchEnd <= 300) {
          event.preventDefault();
        }
        lastTouchEnd = now;
      },
      false,
    );

    // Mejorar rendimiento en scroll
    let ticking = false;
    window.addEventListener("scroll", function () {
      if (!ticking) {
        window.requestAnimationFrame(function () {
          // Aquí puedes añadir efectos de scroll si los necesitas
          ticking = false;
        });
        ticking = true;
      }
    });
  });

  // Cargar fuentes de manera optimizada
  if ("fonts" in document) {
    document.fonts.ready.then(() => {
      document.body.style.opacity = "1";
    });
  }
</script>
