---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackgroundAnimation from "../components/BackgroundAnimation.astro";
import WaterDrops from "../components/WaterDrops.astro";
import Smoke from "../components/Smoke.astro";
---

<Layout
  title="Santiago López | Desarrollador Full Stack & Especialista en Ciberseguridad"
  description="Desarrollador de software especializado en soluciones seguras con expertise en HTML, CSS, JavaScript, TypeScript, Python, Bash, SQL y Java."
>
  <Smoke />
  <BackgroundAnimation />

  <!-- WaterDrops directamente en el nivel base -->
  <WaterDrops />

  <div class="relative">
    <Header />

    <!-- Hero Section - Diseño Más Pulido -->
    <section
      class="min-h-screen flex flex-col justify-center items-center text-center px-4 md:px-6 py-12 md:py-24 relative overflow-hidden"
    >
      <!-- Gradientes de fondo más sutiles -->
      <div
        class="absolute inset-0 bg-gradient-to-br from-gray-900 via-black to-gray-900"
      >
      </div>

      <!-- Elementos decorativos mejorados -->
      <div
        class="absolute top-1/4 -left-1/4 w-1/2 h-1/2 bg-gradient-to-r from-blue-600/10 to-transparent rounded-full blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-1/4 -right-1/4 w-1/2 h-1/2 bg-gradient-to-l from-emerald-600/10 to-transparent rounded-full blur-3xl"
      >
      </div>

      <!-- Partículas de luz decorativas -->
      <div
        class="absolute top-1/3 left-1/4 w-1 h-1 bg-blue-400 rounded-full animate-pulse"
      >
      </div>
      <div
        class="absolute bottom-1/3 right-1/4 w-1 h-1 bg-emerald-400 rounded-full animate-pulse delay-300"
      >
      </div>

      <!-- Contenido principal con mejor jerarquía -->
      <div class="relative max-w-6xl mx-auto w-full px-4">
        <!-- Etiqueta de estado mejorada -->
        <div
          class="inline-flex items-center gap-2 px-4 py-2 mt-8 md:mt-12 mb-10 md:mb-16 bg-gradient-to-r from-gray-900/90 to-gray-800/90 backdrop-blur-xl border border-gray-700/50 rounded-2xl shadow-2xl shadow-black/30"
        >
          <div class="flex items-center gap-2">
            <div class="relative">
              <div class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse">
              </div>
              <div
                class="absolute inset-0 w-2 h-2 bg-emerald-500 rounded-full animate-ping opacity-50"
              >
              </div>
            </div>
            <span
              class="text-xs md:text-sm font-medium text-gray-300 tracking-wide"
            >
              DISPONIBLE PARA PROYECTOS REMOTOS
            </span>
          </div>
        </div>

        <!-- Título con mejor jerarquía visual -->
        <div class="mb-10 md:mb-16">
          <div class="inline-block mb-4">
            <span
              class="text-sm md:text-base font-semibold text-emerald-400/80 tracking-widest uppercase"
            >
              Desarrollador de Software
            </span>
          </div>

          <h1
            class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold mb-4 md:mb-6 tracking-tighter"
          >
            <span class="block text-white mb-3">SANTIAGO</span>
            <span class="block text-white opacity-90 mb-3">LÓPEZ</span>
            <span
              class="block text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-emerald-400 to-blue-400 text-3xl sm:text-4xl md:text-5xl lg:text-6xl mt-6 animate-gradient"
            >
              Full Stack Developer
            </span>
          </h1>
        </div>

        <!-- Descripción mejorada -->
        <div class="max-w-3xl mx-auto mb-12 md:mb-20">
          <p class="text-lg md:text-xl text-gray-300/90 leading-relaxed">
            Especializado en el desarrollo de
            <span class="font-semibold text-emerald-400"
              >aplicaciones web modernas</span
            >
            y
            <span class="font-semibold text-blue-400"
              >soluciones de ciberseguridad</span
            >. Combino experiencia técnica con un enfoque meticuloso para crear
            software escalable, eficiente y seguro.
          </p>
        </div>

        <!-- Badges de tecnologías mejorados -->
        <div class="mb-12 md:mb-20">
          <div class="inline-block mb-4">
            <span class="text-sm font-medium text-gray-400"
              >Tecnologías principales</span
            >
          </div>
          <div
            class="flex flex-wrap justify-center gap-2 md:gap-3 max-w-3xl mx-auto"
          >
            <span
              class="px-3 py-1.5 md:px-4 md:py-2 bg-gradient-to-br from-gray-900/90 to-gray-800/90 backdrop-blur-sm border border-gray-700/30 rounded-lg text-xs md:text-sm font-medium text-emerald-300/90 shadow-lg transition-all duration-300 hover:scale-105 hover:border-emerald-500/30 hover:shadow-emerald-500/10"
            >
              HTML5
            </span>
            <span
              class="px-3 py-1.5 md:px-4 md:py-2 bg-gradient-to-br from-gray-900/90 to-gray-800/90 backdrop-blur-sm border border-gray-700/30 rounded-lg text-xs md:text-sm font-medium text-blue-300/90 shadow-lg transition-all duration-300 hover:scale-105 hover:border-blue-500/30 hover:shadow-blue-500/10"
            >
              CSS3
            </span>
            <span
              class="px-3 py-1.5 md:px-4 md:py-2 bg-gradient-to-br from-gray-900/90 to-gray-800/90 backdrop-blur-sm border border-gray-700/30 rounded-lg text-xs md:text-sm font-medium text-yellow-300/90 shadow-lg transition-all duration-300 hover:scale-105 hover:border-yellow-500/30 hover:shadow-yellow-500/10"
            >
              JavaScript
            </span>
            <span
              class="px-3 py-1.5 md:px-4 md:py-2 bg-gradient-to-br from-gray-900/90 to-gray-800/90 backdrop-blur-sm border border-gray-700/30 rounded-lg text-xs md:text-sm font-medium text-blue-400/90 shadow-lg transition-all duration-300 hover:scale-105 hover:border-blue-500/30 hover:shadow-blue-500/10"
            >
              TypeScript
            </span>
            <span
              class="px-3 py-1.5 md:px-4 md:py-2 bg-gradient-to-br from-gray-900/90 to-gray-800/90 backdrop-blur-sm border border-gray-700/30 rounded-lg text-xs md:text-sm font-medium text-green-400/90 shadow-lg transition-all duration-300 hover:scale-105 hover:border-green-500/30 hover:shadow-green-500/10"
            >
              Python
            </span>
            <span
              class="px-3 py-1.5 md:px-4 md:py-2 bg-gradient-to-br from-gray-900/90 to-gray-800/90 backdrop-blur-sm border border-gray-700/30 rounded-lg text-xs md:text-sm font-medium text-gray-300/90 shadow-lg transition-all duration-300 hover:scale-105 hover:border-gray-500/30 hover:shadow-gray-500/10"
            >
              Bash
            </span>
            <span
              class="px-3 py-1.5 md:px-4 md:py-2 bg-gradient-to-br from-gray-900/90 to-gray-800/90 backdrop-blur-sm border border-gray-700/30 rounded-lg text-xs md:text-sm font-medium text-purple-300/90 shadow-lg transition-all duration-300 hover:scale-105 hover:border-purple-500/30 hover:shadow-purple-500/10"
            >
              SQL
            </span>
            <span
              class="px-3 py-1.5 md:px-4 md:py-2 bg-gradient-to-br from-gray-900/90 to-gray-800/90 backdrop-blur-sm border border-gray-700/30 rounded-lg text-xs md:text-sm font-medium text-red-300/90 shadow-lg transition-all duration-300 hover:scale-105 hover:border-red-500/30 hover:shadow-red-500/10"
            >
              Java
            </span>
          </div>
        </div>

        <!-- CTA Buttons mejorados -->
        <div
          class="flex flex-col sm:flex-row gap-4 justify-center items-center"
        >
          <a
            href="/projects"
            class="group relative px-8 py-4 text-base md:text-lg font-semibold rounded-xl overflow-hidden transition-all duration-500 hover:scale-105 hover:shadow-2xl hover:shadow-blue-500/20 min-h-[52px] flex items-center justify-center w-full sm:w-auto max-w-xs"
          >
            <div
              class="absolute inset-0 bg-gradient-to-r from-blue-600 via-blue-500 to-emerald-600 opacity-90 group-hover:opacity-100 transition-opacity duration-500"
            >
            </div>
            <div
              class="absolute inset-0 bg-gradient-to-r from-blue-700 via-blue-600 to-emerald-700 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
            >
            </div>
            <span
              class="relative flex items-center justify-center gap-3 text-white tracking-wide"
            >
              <svg
                class="w-5 h-5 md:w-6 md:h-6 group-hover:rotate-12 transition-transform duration-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                ></path>
              </svg>
              Explorar Portafolio
            </span>
            <div
              class="absolute inset-0 border border-blue-500/30 rounded-xl group-hover:border-blue-400/50 transition-all duration-500"
            >
            </div>
          </a>

          <a
            href="/contact"
            class="group px-8 py-4 text-base md:text-lg font-semibold rounded-xl border-2 border-emerald-500/50 text-emerald-300 hover:bg-emerald-500/10 hover:text-emerald-200 hover:border-emerald-400 transition-all duration-500 hover:scale-105 hover:shadow-2xl hover:shadow-emerald-500/20 min-h-[52px] flex items-center justify-center gap-3 w-full sm:w-auto max-w-xs backdrop-blur-sm"
          >
            <svg
              class="w-5 h-5 md:w-6 md:h-6 group-hover:translate-x-1 transition-transform duration-300"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            Contactar Ahora
          </a>
        </div>
      </div>

      <!-- Scroll indicator mejorado -->
      <div
        class="absolute bottom-4 left-1/2 transform -translate-x-1/10 animate-bounce z-10"
      >
        <div class="flex flex-col items-center">
          <span class="text-xs text-gray-400/70 mb-2 tracking-widest"
            >DESCUBRE MÁS</span
          >
          <div
            class="w-6 h-10 border border-emerald-500/30 rounded-full flex justify-center relative backdrop-blur-sm group hover:border-emerald-400/50 transition-all duration-300"
          >
            <div
              class="w-0.5 h-3 bg-emerald-500 rounded-full mt-2 animate-pulse group-hover:bg-emerald-400"
            >
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Tecnologías Detalladas - Diseño Más PULIDO -->
    <section class="py-20 md:py-32 px-4 md:px-6 relative overflow-hidden">
      <!-- Fondo gradiente para la sección -->
      <div
        class="absolute inset-0 bg-gradient-to-b from-gray-900/20 via-black/50 to-gray-900/20"
      >
      </div>

      <!-- Líneas decorativas -->
      <div
        class="absolute top-0 left-1/2 transform -translate-x-1/2 w-px h-full bg-gradient-to-b from-transparent via-blue-500/10 to-transparent"
      >
      </div>

      <div class="container mx-auto max-w-6xl relative">
        <!-- Encabezado mejorado -->
        <div class="text-center mb-16 md:mb-24 px-4">
          <div class="inline-block mb-3">
            <span
              class="text-xs md:text-sm font-medium text-emerald-400/80 tracking-widest uppercase"
            >
              Stack Tecnológico
            </span>
          </div>

          <h2
            class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 tracking-tight"
          >
            <span class="text-white">Dominio</span>
            <span
              class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400 block"
            >
              Completo
            </span>
          </h2>

          <p
            class="text-gray-400/80 text-base md:text-lg max-w-2xl mx-auto leading-relaxed"
          >
            Especialización en las tecnologías más demandadas para el desarrollo
            de soluciones modernas y escalables.
          </p>
        </div>

        <!-- Grid de tecnologías mejorado -->
        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8 px-4"
        >
          <!-- Frontend Card - Mejorada -->
          <div
            class="group relative p-6 md:p-8 rounded-2xl bg-gradient-to-br from-gray-900/80 to-gray-800/80 backdrop-blur-xl border border-gray-700/30 shadow-2xl shadow-black/30 transition-all duration-500 hover:scale-[1.02] hover:border-blue-500/30 hover:shadow-blue-500/10"
          >
            <div
              class="absolute -top-3 -right-3 w-12 h-12 bg-blue-500/10 rounded-full blur-xl"
            >
            </div>

            <div class="flex items-center gap-4 mb-6">
              <div
                class="w-12 h-12 bg-gradient-to-br from-blue-900/30 to-blue-800/30 rounded-xl flex items-center justify-center backdrop-blur-sm"
              >
                <svg
                  class="w-6 h-6 text-blue-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold text-white">Frontend</h3>
                <p class="text-sm text-gray-400/80">Interfaces modernas</p>
              </div>
            </div>

            <div class="space-y-4">
              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-300 font-medium">HTML5</span>
                  <span class="text-sm text-emerald-400 font-semibold">95%</span
                  >
                </div>
                <div class="h-2 bg-gray-800/50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-blue-500 to-emerald-500 rounded-full progress-bar"
                    style="width: 95%"
                  >
                  </div>
                </div>
              </div>

              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-300 font-medium">CSS3</span>
                  <span class="text-sm text-emerald-400 font-semibold">90%</span
                  >
                </div>
                <div class="h-2 bg-gray-800/50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-blue-500 to-emerald-500 rounded-full progress-bar"
                    style="width: 90%"
                  >
                  </div>
                </div>
              </div>

              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-300 font-medium">JavaScript</span>
                  <span class="text-sm text-emerald-400 font-semibold">92%</span
                  >
                </div>
                <div class="h-2 bg-gray-800/50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-blue-500 to-emerald-500 rounded-full progress-bar"
                    style="width: 92%"
                  >
                  </div>
                </div>
              </div>

              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-300 font-medium">TypeScript</span>
                  <span class="text-sm text-emerald-400 font-semibold">85%</span
                  >
                </div>
                <div class="h-2 bg-gray-800/50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-blue-500 to-emerald-500 rounded-full progress-bar"
                    style="width: 85%"
                  >
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Backend Card - Mejorada -->
          <div
            class="group relative p-6 md:p-8 rounded-2xl bg-gradient-to-br from-gray-900/80 to-gray-800/80 backdrop-blur-xl border border-gray-700/30 shadow-2xl shadow-black/30 transition-all duration-500 hover:scale-[1.02] hover:border-purple-500/30 hover:shadow-purple-500/10"
          >
            <div
              class="absolute -top-3 -left-3 w-12 h-12 bg-purple-500/10 rounded-full blur-xl"
            >
            </div>

            <div class="flex items-center gap-4 mb-6">
              <div
                class="w-12 h-12 bg-gradient-to-br from-purple-900/30 to-purple-800/30 rounded-xl flex items-center justify-center backdrop-blur-sm"
              >
                <svg
                  class="w-6 h-6 text-purple-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold text-white">Backend</h3>
                <p class="text-sm text-gray-400/80">Lógica del servidor</p>
              </div>
            </div>

            <div class="space-y-4">
              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-300 font-medium">Python</span>
                  <span class="text-sm text-emerald-400 font-semibold">88%</span
                  >
                </div>
                <div class="h-2 bg-gray-800/50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-purple-500 to-emerald-500 rounded-full progress-bar"
                    style="width: 88%"
                  >
                  </div>
                </div>
              </div>

              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-300 font-medium">Java</span>
                  <span class="text-sm text-emerald-400 font-semibold">82%</span
                  >
                </div>
                <div class="h-2 bg-gray-800/50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-purple-500 to-emerald-500 rounded-full progress-bar"
                    style="width: 82%"
                  >
                  </div>
                </div>
              </div>

              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-300 font-medium">Node.js</span>
                  <span class="text-sm text-emerald-400 font-semibold">85%</span
                  >
                </div>
                <div class="h-2 bg-gray-800/50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-purple-500 to-emerald-500 rounded-full progress-bar"
                    style="width: 85%"
                  >
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Bases de Datos Card - Mejorada -->
          <div
            class="group relative p-6 md:p-8 rounded-2xl bg-gradient-to-br from-gray-900/80 to-gray-800/80 backdrop-blur-xl border border-gray-700/30 shadow-2xl shadow-black/30 transition-all duration-500 hover:scale-[1.02] hover:border-yellow-500/30 hover:shadow-yellow-500/10"
          >
            <div
              class="absolute -bottom-3 -right-3 w-12 h-12 bg-yellow-500/10 rounded-full blur-xl"
            >
            </div>

            <div class="flex items-center gap-4 mb-6">
              <div
                class="w-12 h-12 bg-gradient-to-br from-yellow-900/30 to-yellow-800/30 rounded-xl flex items-center justify-center backdrop-blur-sm"
              >
                <svg
                  class="w-6 h-6 text-yellow-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold text-white">Bases de Datos</h3>
                <p class="text-sm text-gray-400/80">Gestión de datos</p>
              </div>
            </div>

            <div class="space-y-4">
              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-300 font-medium">SQL</span>
                  <span class="text-sm text-emerald-400 font-semibold">90%</span
                  >
                </div>
                <div class="h-2 bg-gray-800/50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-yellow-500 to-emerald-500 rounded-full progress-bar"
                    style="width: 90%"
                  >
                  </div>
                </div>
              </div>

              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-300 font-medium">PostgreSQL</span>
                  <span class="text-sm text-emerald-400 font-semibold">85%</span
                  >
                </div>
                <div class="h-2 bg-gray-800/50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-yellow-500 to-emerald-500 rounded-full progress-bar"
                    style="width: 85%"
                  >
                  </div>
                </div>
              </div>

              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-300 font-medium">MongoDB</span>
                  <span class="text-sm text-emerald-400 font-semibold">80%</span
                  >
                </div>
                <div class="h-2 bg-gray-800/50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-yellow-500 to-emerald-500 rounded-full progress-bar"
                    style="width: 80%"
                  >
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- DevOps & Tools Card - Mejorada -->
          <div
            class="group relative p-6 md:p-8 rounded-2xl bg-gradient-to-br from-gray-900/80 to-gray-800/80 backdrop-blur-xl border border-gray-700/30 shadow-2xl shadow-black/30 transition-all duration-500 hover:scale-[1.02] hover:border-red-500/30 hover:shadow-red-500/10"
          >
            <div
              class="absolute -bottom-3 -left-3 w-12 h-12 bg-red-500/10 rounded-full blur-xl"
            >
            </div>

            <div class="flex items-center gap-4 mb-6">
              <div
                class="w-12 h-12 bg-gradient-to-br from-red-900/30 to-red-800/30 rounded-xl flex items-center justify-center backdrop-blur-sm"
              >
                <svg
                  class="w-6 h-6 text-red-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
