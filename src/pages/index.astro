            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 bg-purple-900/30 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-white">Backend</h3>
            </div>
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-gray-300">Python</span>
                <div class="w-24 h-2 bg-gray-800 rounded-full overflow-hidden">
                  <div class="h-full bg-emerald-500 rounded-full" style="width: 88%"></div>
                </div>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-gray-300">Java</span>
                <div class="w-24 h-2 bg-gray-800 rounded-full overflow-hidden">
                  <div class="h-full bg-emerald-500 rounded-full" style="width: 82%"></div>
                </div>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-gray-300">Node.js</span>
                <div class="w-24 h-2 bg-gray-800 rounded-full overflow-hidden">
                  <div class="h-full bg-emerald-500 rounded-full" style="width: 85%"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Bases de Datos -->
          <div class="group p-6 rounded-xl bg-gray-900/50 border border-gray-800 hover:border-yellow-500/30 transition-all duration-300">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 bg-yellow-900/30 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-white">Bases de Datos</h3>
            </div>
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-gray-300">SQL</span>
                <div class="w-24 h-2 bg-gray-800 rounded-full overflow-hidden">
                  <div class="h-full bg-emerald-500 rounded-full" style="width: 90%"></div>
                </div>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-gray-300">PostgreSQL</span>
                <div class="w-24 h-2 bg-gray-800 rounded-full overflow-hidden">
                  <div class="h-full bg-emerald-500 rounded-full" style="width: 85%"></div>
                </div>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-gray-300">MongoDB</span>
                <div class="w-24 h-2 bg-gray-800 rounded-full overflow-hidden">
                  <div class="h-full bg-emerald-500 rounded-full" style="width: 80%"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- DevOps & Tools -->
          <div class="group p-6 rounded-xl bg-gray-900/50 border border-gray-800 hover:border-red-500/30 transition-all duration-300">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 bg-red-900/30 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-white">DevOps & Tools</h3>
            </div>
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-gray-300">Bash</span>
                <div class="w-24 h-2 bg-gray-800 rounded-full overflow-hidden">
                  <div class="h-full bg-emerald-500 rounded-full" style="width: 87%"></div>
                </div>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-gray-300">Git</span>
                <div class="w-24 h-2 bg-gray-800 rounded-full overflow-hidden">
                  <div class="h-full bg-emerald-500 rounded-full" style="width: 95%"></div>
                </div>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-gray-300">Docker</span>
                <div class="w-24 h-2 bg-gray-800 rounded-full overflow-hidden">
                  <div class="h-full bg-emerald-500 rounded-full" style="width: 80%"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Proyectos Destacados Preview -->
        <div class="mt-20 text-center">
          <h3 class="text-2xl font-bold text-white mb-8">Proyectos Recientes</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
            <div class="p-6 bg-gray-900/50 rounded-xl border border-gray-800">
              <div class="text-emerald-400 text-3xl mb-4">🛡️</div>
              <h4 class="text-lg font-bold text-white mb-2">Sistema de Auditoría</h4>
              <p class="text-gray-400 text-sm">Plataforma de seguridad con Python y Bash</p>
            </div>
            <div class="p-6 bg-gray-900/50 rounded-xl border border-gray-800">
              <div class="text-blue-400 text-3xl mb-4">⚛️</div>
              <h4 class="text-lg font-bold text-white mb-2">App Full Stack</h4>
              <p class="text-gray-400 text-sm">React + TypeScript + Java + PostgreSQL</p>
            </div>
            <div class="p-6 bg-gray-900/50 rounded-xl border border-gray-800">
              <div class="text-purple-400 text-3xl mb-4">🔐</div>
              <h4 class="text-lg font-bold text-white mb-2">API Segura</h4>
              <p class="text-gray-400 text-sm">Node.js con autenticación JWT y encriptación</p>
            </div>
          </div>
          <a href="/projects" class="inline-flex items-center gap-2 text-emerald-400 hover:text-emerald-300">
            Ver todos los proyectos
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
