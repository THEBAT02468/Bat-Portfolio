          <div class="text-center p-8 rounded-xl bg-gray-900/30">
            <div class="w-16 h-16 bg-emerald-900/20 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg class="w-8 h-8 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-4">Código Eficiente</h3>
            <p class="text-gray-400">Optimización de performance y escalabilidad en cada línea de código</p>
          </div>

          <div class="text-center p-8 rounded-xl bg-gray-900/30">
            <div class="w-16 h-16 bg-purple-900/20 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg class="w-8 h-8 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-4">Entrega Rápida</h3>
            <p class="text-gray-400">Metodologías ágiles para resultados tangibles en tiempo récord</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action Final -->
    <section class="py-24 px-4 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-blue-900/10 via-gray-900/10 to-emerald-900/10"></div>
      <div class="container mx-auto max-w-4xl relative z-10 text-center">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">
          ¿Proyecto en mente?
          <span class="block text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400 text-3xl md:text-4xl mt-4">
            Hagámoslo realidad
          </span>
        </h2>
        <p class="text-gray-400 text-lg mb-10 max-w-2xl mx-auto">
          Desde una simple consulta hasta un proyecto complejo, estoy aquí para ayudarte a 
          construir la solución perfecta con las mejores tecnologías.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/contact" 
            class="px-10 py-4 bg-gradient-to-r from-blue-600 to-emerald-600 text-white font-semibold rounded-lg hover:from-blue-700 hover:to-emerald-700 transition-all duration-300 hover:scale-105 text-lg"
          >
            Iniciar Conversación
          </a>
          <a 
            href="mailto:sdlv2882@gmail.com" 
            class="px-10 py-4 border-2 border-emerald-500 text-emerald-400 font-semibold rounded-lg hover:bg-emerald-500 hover:text-white transition-all duration-300 text-lg flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            sdlv2882@gmail.com
          </a>
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Layout>

<style>
  /* Animación de bounce mejorada */
  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% {
      transform: translateY(0) translateX(-50%);
    }
    40% {
      transform: translateY(-15px) translateX(-50%);
    }
    60% {
      transform: translateY(-7px) translateX(-50%);
    }
  }

  .animate-bounce {
    animation: bounce 2s infinite;
  }

  /* Efecto de brillo en badges de tecnología */
  .tech-badge {
    position: relative;
    overflow: hidden;
  }

  .tech-badge::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
      to right,
      transparent,
      rgba(255, 255, 255, 0.1),
      transparent
    );
    transform: rotate(30deg);
    transition: transform 0.6s;
  }

  .tech-badge:hover::after {
    transform: rotate(30deg) translate(20%, 20%);
  }

  /* Animación de progreso */
  @keyframes progress {
    from {
      width: 0;
    }
  }

  .progress-bar > div {
    animation: progress 1.5s ease-out forwards;
  }

  /* Efecto hover en tarjetas */
  .hover-lift {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .hover-lift:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  /* Gradiente animado */
  .animated-gradient {
    background: linear-gradient(-45deg, #3b82f6, #10b981, #3b82f6, #10b981);
    background-size: 400% 400%;
    animation: gradient 8s ease infinite;
  }

  @keyframes gradient {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  /* Scrollbar personalizada */
  ::-webkit-scrollbar {
    width: 10px;
  }

  ::-webkit-scrollbar-track {
    background: #0f172a;
  }

  ::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, #3b82f6, #10b981);
    border-radius: 5px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg, #2563eb, #059669);
  }

  /* Animación de código flotante */
  @keyframes float-code {
    0%, 100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-20px) rotate(1deg);
    }
  }

  .floating-code {
    animation: float-code 6s ease-in-out infinite;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    // Animación de barras de progreso
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const progressBars = entry.target.querySelectorAll('.progress-bar > div');
          progressBars.forEach(bar => {
            // Reiniciar animación
            bar.style.animation = 'none';
            setTimeout(() => {
              bar.style.animation = 'progress 1.5s ease-out forwards';
            }, 10);
          });
        }
      });
    }, { threshold: 0.5 });

    // Observar sección de tecnologías
    const techSection = document.querySelector('section:nth-of-type(2)');
    if (techSection) observer.observe(techSection);

    // Smooth scroll para enlaces internos
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    });

    // Efecto hover en badges de tecnología
    const techBadges = document.querySelectorAll('[class*="px-4 py-2 bg-gray-800"]');
    techBadges.forEach(badge => {
      badge.addEventListener('mouseenter', function() {
        this.style.transform = 'scale(1.05)';
      });
      badge.addEventListener('mouseleave', function() {
        this.style.transform = 'scale(1)';
      });
    });
  });
</script>