---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackgroundAnimation from "../components/BackgroundAnimation.astro";
import WaterDrops from "../components/WaterDrops.astro";
import Smoke from "../components/Smoke.astro";
---

<Layout
  title="Santiago López | Desarrollador Full Stack & Especialista en Ciberseguridad"
  description="Desarrollador de software especializado en soluciones seguras con expertise en HTML, CSS, JavaScript, TypeScript, Python, Bash, SQL y Java."
>
  <Smoke />
  <BackgroundAnimation />

  <!-- WaterDrops directamente en el nivel base -->
  <WaterDrops />

  <div class="relative">
    <Header />

    <!-- Hero Section — Layout 2 columnas -->
    <section class="min-h-screen flex flex-col md:flex-row relative overflow-hidden">

      <!-- Overlay + city grid (toda la sección) -->
      <div class="absolute inset-0" style="background: rgba(0,0,0,0.50); z-index: 1;">
        <div class="absolute inset-0 gotham-grid opacity-40"></div>
      </div>

      <!-- Ambient glows -->
      <div class="absolute top-1/3 left-0 w-80 h-80 rounded-full blur-3xl pointer-events-none" style="background: radial-gradient(circle, rgba(0,212,255,0.08) 0%, transparent 70%); z-index: 2;"></div>
      <div class="absolute bottom-1/4 left-1/4 w-64 h-64 rounded-full blur-3xl pointer-events-none" style="background: radial-gradient(circle, rgba(255,215,0,0.06) 0%, transparent 70%); z-index: 2;"></div>

      <!-- Partículas -->
      <div class="absolute top-1/3 left-1/4 w-1 h-1 rounded-full animate-pulse" style="background: #00d4ff; box-shadow: 0 0 6px #00d4ff; z-index: 2;"></div>
      <div class="absolute bottom-1/3 left-1/3 w-1 h-1 rounded-full animate-pulse" style="background: #FFD700; box-shadow: 0 0 6px #FFD700; z-index: 2; animation-delay: 0.4s;"></div>
      <div class="absolute top-2/3 left-1/6 w-0.5 h-0.5 rounded-full animate-pulse" style="background: #8b5cf6; box-shadow: 0 0 4px #8b5cf6; z-index: 2; animation-delay: 0.8s;"></div>

      <!-- ── COLUMNA IZQUIERDA: contenido ───────────────── -->
      <div class="relative z-10 w-full md:w-[48%] flex flex-col justify-center items-center px-6 md:px-10 lg:px-14 pt-28 md:pt-0 pb-10 md:pb-0 text-center">

        <!-- Badge -->
        <div class="inline-flex items-center gap-3 px-4 py-2 mb-8 backdrop-blur-xl"
          style="background: rgba(0,0,0,0.85); border: 1px solid rgba(255,215,0,0.4); box-shadow: 0 0 16px rgba(255,215,0,0.1);">
          <div class="relative flex-shrink-0">
            <div class="w-2 h-2 rounded-full animate-pulse" style="background: #00d4ff; box-shadow: 0 0 6px #00d4ff;"></div>
            <div class="absolute inset-0 w-2 h-2 rounded-full animate-ping opacity-60" style="background: #00d4ff;"></div>
          </div>
          <span class="text-xs font-black tracking-widest uppercase" style="color: #FFD700; font-family: 'Cinzel', serif; letter-spacing: 0.14em; text-shadow: 0 0 8px rgba(255,215,0,0.6);">
            ⬡ Disponible para proyectos remotos ⬡
          </span>
        </div>

        <!-- Descripción -->
        <p class="text-base md:text-lg text-gray-400 leading-relaxed mb-8 max-w-md">
          Especializado en el desarrollo de
          <span class="font-bold" style="color: #FFD700; text-shadow: 0 0 8px rgba(255,215,0,0.5);">aplicaciones web modernas</span>
          y
          <span class="font-bold" style="color: #00d4ff; text-shadow: 0 0 8px rgba(0,212,255,0.5);">soluciones de ciberseguridad</span>.
          Combino experiencia técnica con un enfoque meticuloso para crear software escalable, eficiente y seguro.
        </p>

        <!-- Tech badges -->
        <div class="mb-10 w-full">
          <span class="text-xs font-medium text-gray-500 tracking-widest uppercase block mb-3">Tecnologías principales</span>
          <div class="flex flex-wrap gap-2 max-w-md mx-auto justify-center">
            {[
              { label: 'HTML5',      color: '#FFD700' },
              { label: 'CSS3',       color: '#00d4ff' },
              { label: 'JavaScript', color: '#FFD700' },
              { label: 'TypeScript', color: '#00d4ff' },
              { label: 'Python',     color: '#8b5cf6' },
              { label: 'Bash',       color: '#9ca3af' },
              { label: 'SQL',        color: '#8b5cf6' },
              { label: 'Java',       color: '#ff6b6b' },
            ].map(({ label, color }) => (
              <span class="px-3 py-1 text-xs font-bold tracking-wide"
                style={`border: 1px solid ${color}40; color: ${color}; background: ${color}0d;`}>
                {label}
              </span>
            ))}
          </div>
        </div>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a href="/projects"
            class="group relative flex items-center justify-center gap-3 overflow-hidden transition-all duration-300 hover:scale-105"
            style="padding: 0.85rem 1.8rem; background: linear-gradient(135deg, #FFD700 0%, #d97706 50%, #FFD700 100%); background-size: 200% 100%; border: 2px solid rgba(255,215,0,0.7); box-shadow: 0 0 20px rgba(255,215,0,0.4); font-family: 'Cinzel', serif; font-weight: 900; font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: #000;"
            onmouseover="this.style.boxShadow='0 0 40px rgba(255,215,0,0.9)'; this.style.backgroundPosition='100% 0'"
            onmouseout="this.style.boxShadow='0 0 20px rgba(255,215,0,0.4)'; this.style.backgroundPosition='0 0'">
            <svg class="w-4 h-4 group-hover:rotate-12 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
            Explorar Portafolio
            <div class="absolute inset-0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700" style="background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);"></div>
          </a>

          <a href="/contact"
            class="group flex items-center justify-center gap-3 transition-all duration-300 hover:scale-105"
            style="padding: 0.85rem 1.8rem; border: 2px solid rgba(0,212,255,0.5); color: #00d4ff; font-family: 'Cinzel', serif; font-weight: 700; font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; box-shadow: 0 0 12px rgba(0,212,255,0.15); backdrop-filter: blur(8px);"
            onmouseover="this.style.background='rgba(0,212,255,0.08)'; this.style.boxShadow='0 0 25px rgba(0,212,255,0.4)'; this.style.borderColor='rgba(0,212,255,0.8)'; this.style.color='#fff'"
            onmouseout="this.style.background='transparent'; this.style.boxShadow='0 0 12px rgba(0,212,255,0.15)'; this.style.borderColor='rgba(0,212,255,0.5)'; this.style.color='#00d4ff'">
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            Contactar Ahora
          </a>
        </div>

        <!-- Scroll indicator -->
        <div class="hidden md:flex flex-col items-center gap-2 mt-16">
          <span class="text-xs font-black tracking-widest uppercase" style="color: #FFD700; font-family: 'Cinzel', serif; font-size: 0.5rem; letter-spacing: 0.25em; text-shadow: 0 0 6px rgba(255,215,0,0.6);">Descubre más</span>
          <div class="w-5 h-9 flex justify-center animate-bounce" style="border: 1px solid rgba(255,215,0,0.4); box-shadow: 0 0 8px rgba(255,215,0,0.15);">
            <div class="w-0.5 h-2.5 mt-1.5 animate-pulse" style="background: #FFD700; box-shadow: 0 0 6px rgba(255,215,0,0.8);"></div>
          </div>
        </div>
      </div>

      <!-- ── COLUMNA DERECHA: imagen + Fuente.png ────────── -->
      <div id="hero-right-col"
           class="relative z-10 w-full md:w-[52%] flex items-end justify-center h-[60vh] md:h-screen"
           style="transition: opacity 0.25s ease, transform 0.35s ease;">

        <!-- Borde neón angular -->
        <div class="hero-glow-border"></div>

        <!-- Marco con clip-path angular estilo Gotham -->
        <div class="hero-img-frame absolute inset-0">
          <img
            src="/images/Background.png"
            alt="Santiago López"
            class="hero-img w-full h-full object-cover object-top pointer-events-none select-none"
          />
          <!-- Fusión izquierda -->
          <div class="absolute inset-y-0 left-0 w-28 pointer-events-none"
               style="background: linear-gradient(90deg, rgba(0,0,0,0.75) 0%, transparent 100%);"></div>
          <!-- Fusión inferior — se pierde en el fondo -->
          <div class="absolute bottom-0 left-0 right-0 h-48 pointer-events-none"
               style="background: linear-gradient(0deg, rgba(0,0,0,0.90) 0%, rgba(0,0,0,0.40) 50%, transparent 100%);"></div>
        </div>

        <!-- Fuente.png con animación de entrada -->
        <img
          src="/images/Fuente.png"
          alt="Santiago López — Ingeniero Informático"
          class="fuente-img relative w-full max-w-xl pointer-events-none select-none mb-6 md:mb-10 px-4"
          style="z-index: 4; filter: drop-shadow(0 0 24px rgba(255,215,0,0.7)) drop-shadow(0 0 8px rgba(0,0,0,1));"
        />
      </div>

    </section>

    <!-- Sección de Tecnologías -->
    <section class="py-20 md:py-32 px-4 md:px-6 relative overflow-hidden">
      <!-- Fondo negro con city grid -->
      <div class="absolute inset-0" style="background: rgba(0,0,0,0.50);">
        <div class="absolute inset-0 gotham-grid opacity-40"></div>
      </div>
      <!-- Línea vertical central neón -->
      <div class="absolute top-0 left-1/2 transform -translate-x-1/2 w-px h-full" style="background: linear-gradient(to bottom, transparent, rgba(255,215,0,0.15), transparent);"></div>
      <!-- Divisor superior -->
      <div class="absolute top-0 left-0 right-0 h-px" style="background: linear-gradient(90deg, transparent, rgba(255,215,0,0.4), transparent); box-shadow: 0 0 8px rgba(255,215,0,0.3);"></div>

      <div class="container mx-auto max-w-6xl relative">
        <!-- Encabezado -->
        <div class="text-center mb-16 md:mb-24 px-4">
          <div class="inline-block mb-4">
            <span class="text-xs font-black tracking-widest uppercase" style="color: #00d4ff; font-family: 'Cinzel', serif; letter-spacing: 0.2em; text-shadow: 0 0 8px rgba(0,212,255,0.7);">
              ─── Stack Tecnológico ───
            </span>
          </div>

          <h2 class="font-black mb-6" style="font-family: 'Cinzel Decorative', serif; font-size: clamp(2.5rem, 6vw, 4.5rem); letter-spacing: 0.06em; line-height: 1.1;">
            <span class="text-white">DOMINIO</span>
            <span class="block" style="color: #FFD700; text-shadow: 0 0 30px rgba(255,215,0,0.7), 0 0 60px rgba(255,215,0,0.3);">COMPLETO</span>
          </h2>

          <p class="text-gray-500 text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
            Especialización en las tecnologías más demandadas para el desarrollo de soluciones modernas y escalables.
          </p>
        </div>

        <!-- Grid de tecnologías mejorado -->
        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8 px-4"
        >
          <!-- Frontend Card -->
          <div
            class="group relative p-6 md:p-8 transition-all duration-500 hover:scale-[1.02]"
            style="background: linear-gradient(145deg, #080808, #000); border: 1px solid rgba(255,215,0,0.25); box-shadow: 0 4px 24px rgba(0,0,0,0.9), inset 0 0 20px rgba(255,215,0,0.03);"
            onmouseover="this.style.borderColor='rgba(255,215,0,0.6)'; this.style.boxShadow='0 0 30px rgba(255,215,0,0.2), 0 8px 40px rgba(0,0,0,1)';"
            onmouseout="this.style.borderColor='rgba(255,215,0,0.25)'; this.style.boxShadow='0 4px 24px rgba(0,0,0,0.9), inset 0 0 20px rgba(255,215,0,0.03)';"
          >
            <div
              class="absolute -top-3 -right-3 w-12 h-12 bg-blue-500/10 rounded-full blur-xl"
            >
            </div>

            <div class="flex items-center gap-4 mb-6">
              <div
                class="w-12 h-12 bg-gradient-to-br from-blue-900/30 to-blue-800/30 rounded-xl flex items-center justify-center backdrop-blur-sm"
              >
                <svg
                  class="w-6 h-6 text-blue-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold text-white">Frontend</h3>
                <p class="text-sm text-gray-400/80">Interfaces modernas</p>
              </div>
            </div>

            <div class="space-y-4">
              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-300 font-medium">HTML5</span>
                  <span class="text-sm text-emerald-400 font-semibold">95%</span
                  >
                </div>
                <div class="h-2 bg-gray-800/50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-blue-500 to-emerald-500 rounded-full progress-bar"
                    style="width: 95%"
                  >
                  </div>
                </div>
              </div>

              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-300 font-medium">CSS3</span>
                  <span class="text-sm text-emerald-400 font-semibold">90%</span
                  >
                </div>
                <div class="h-2 bg-gray-800/50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-blue-500 to-emerald-500 rounded-full progress-bar"
                    style="width: 90%"
                  >
                  </div>
                </div>
              </div>

              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-300 font-medium">JavaScript</span>
                  <span class="text-sm text-emerald-400 font-semibold">92%</span
                  >
                </div>
                <div class="h-2 bg-gray-800/50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-blue-500 to-emerald-500 rounded-full progress-bar"
                    style="width: 92%"
                  >
                  </div>
                </div>
              </div>

              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-300 font-medium">TypeScript</span>
                  <span class="text-sm text-emerald-400 font-semibold">85%</span
                  >
                </div>
                <div class="h-2 bg-gray-800/50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-blue-500 to-emerald-500 rounded-full progress-bar"
                    style="width: 85%"
                  >
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Backend Card -->
          <div
            class="group relative p-6 md:p-8 transition-all duration-500 hover:scale-[1.02]"
            style="background: linear-gradient(145deg, #080808, #000); border: 1px solid rgba(139,92,246,0.25); box-shadow: 0 4px 24px rgba(0,0,0,0.9), inset 0 0 20px rgba(139,92,246,0.03);"
            onmouseover="this.style.borderColor='rgba(139,92,246,0.6)'; this.style.boxShadow='0 0 30px rgba(139,92,246,0.2), 0 8px 40px rgba(0,0,0,1)';"
            onmouseout="this.style.borderColor='rgba(139,92,246,0.25)'; this.style.boxShadow='0 4px 24px rgba(0,0,0,0.9), inset 0 0 20px rgba(139,92,246,0.03)';"
          >
            <div
              class="absolute -top-3 -left-3 w-12 h-12 bg-purple-500/10 rounded-full blur-xl"
            >
            </div>

            <div class="flex items-center gap-4 mb-6">
              <div
                class="w-12 h-12 bg-gradient-to-br from-purple-900/30 to-purple-800/30 rounded-xl flex items-center justify-center backdrop-blur-sm"
              >
                <svg
                  class="w-6 h-6 text-purple-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold text-white">Backend</h3>
                <p class="text-sm text-gray-400/80">Lógica del servidor</p>
              </div>
            </div>

            <div class="space-y-4">
              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-300 font-medium">Python</span>
                  <span class="text-sm text-emerald-400 font-semibold">88%</span
                  >
                </div>
                <div class="h-2 bg-gray-800/50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-purple-500 to-emerald-500 rounded-full progress-bar"
                    style="width: 88%"
                  >
                  </div>
                </div>
              </div>

              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-300 font-medium">Java</span>
                  <span class="text-sm text-emerald-400 font-semibold">82%</span
                  >
                </div>
                <div class="h-2 bg-gray-800/50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-purple-500 to-emerald-500 rounded-full progress-bar"
                    style="width: 82%"
                  >
                  </div>
                </div>
              </div>

              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-300 font-medium">Node.js</span>
                  <span class="text-sm text-emerald-400 font-semibold">85%</span
                  >
                </div>
                <div class="h-2 bg-gray-800/50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-purple-500 to-emerald-500 rounded-full progress-bar"
                    style="width: 85%"
                  >
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Bases de Datos Card -->
          <div
            class="group relative p-6 md:p-8 transition-all duration-500 hover:scale-[1.02]"
            style="background: linear-gradient(145deg, #080808, #000); border: 1px solid rgba(0,212,255,0.25); box-shadow: 0 4px 24px rgba(0,0,0,0.9), inset 0 0 20px rgba(0,212,255,0.03);"
            onmouseover="this.style.borderColor='rgba(0,212,255,0.6)'; this.style.boxShadow='0 0 30px rgba(0,212,255,0.2), 0 8px 40px rgba(0,0,0,1)';"
            onmouseout="this.style.borderColor='rgba(0,212,255,0.25)'; this.style.boxShadow='0 4px 24px rgba(0,0,0,0.9), inset 0 0 20px rgba(0,212,255,0.03)';"
          >
            <div
              class="absolute -bottom-3 -right-3 w-12 h-12 bg-yellow-500/10 rounded-full blur-xl"
            >
            </div>

            <div class="flex items-center gap-4 mb-6">
              <div
                class="w-12 h-12 bg-gradient-to-br from-yellow-900/30 to-yellow-800/30 rounded-xl flex items-center justify-center backdrop-blur-sm"
              >
                <svg
                  class="w-6 h-6 text-yellow-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold text-white">Bases de Datos</h3>
                <p class="text-sm text-gray-400/80">Gestión de datos</p>
              </div>
            </div>

            <div class="space-y-4">
              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-300 font-medium">SQL</span>
                  <span class="text-sm text-emerald-400 font-semibold">90%</span
                  >
                </div>
                <div class="h-2 bg-gray-800/50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-yellow-500 to-emerald-500 rounded-full progress-bar"
                    style="width: 90%"
                  >
                  </div>
                </div>
              </div>

              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-300 font-medium">PostgreSQL</span>
                  <span class="text-sm text-emerald-400 font-semibold">85%</span
                  >
                </div>
                <div class="h-2 bg-gray-800/50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-yellow-500 to-emerald-500 rounded-full progress-bar"
                    style="width: 85%"
                  >
                  </div>
                </div>
              </div>

              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-gray-300 font-medium">MongoDB</span>
                  <span class="text-sm text-emerald-400 font-semibold">80%</span
                  >
                </div>
                <div class="h-2 bg-gray-800/50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-yellow-500 to-emerald-500 rounded-full progress-bar"
                    style="width: 80%"
                  >
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- DevOps & Tools Card -->
          <div
            class="group relative p-6 md:p-8 transition-all duration-500 hover:scale-[1.02]"
            style="background: linear-gradient(145deg, #080808, #000); border: 1px solid rgba(139,92,246,0.25); box-shadow: 0 4px 24px rgba(0,0,0,0.9), inset 0 0 20px rgba(139,92,246,0.03);"
