---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackgroundAnimation from "../components/BackgroundAnimation.astro";
import WaterDrops from "../components/WaterDrops.astro";
import Smoke from "../components/Smoke.astro";
---

<Layout
  title="Portfolio Gótico - Batman Style"
  description="Portfolio de Santiago, desarrollador de software con temática Gótica inspirada en Batman"
>
  <Smoke />
  <!-- Fondo animado por frames -->
  <BackgroundAnimation />
  <!-- 👈 aquí insertamos la animación -->
  
  <!-- Efecto de humo con Three.js -->
  <!-- Contenedor principal con posición relativa para controlar el z-index -->
  <div class="relative z-10">
    <WaterDrops />
    <!-- Efectos de lluvia y niebla -->

    <div class="rain" aria-hidden="true"></div>
    <!-- <div class="fog" aria-hidden="true"></div> -->

    <Header />

    <!-- Hero Section -->
    <section
      class="min-h-screen flex flex-col justify-center items-center text-center px-4"
    >
      <h1 class="text-5xl sm:text-6xl md:text-7xl font-bold mb-4">
        Soy <span class="text-yellow-400">Santiago</span>
      </h1>
      <p class="mt-4 text-gray-300 max-w-2xl text-xl">
        Desarrollador de software en la <span
          class="text-yellow-400 font-medium">Gotham digital</span
        >, creando soluciones en la oscuridad.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4">
        <a href="#projects" class="btn-bat mt-6 px-8 py-4 text-lg"
          >Ver Proyectos</a
        >
        <a
          href="#contact"
          class="border border-yellow-400 text-yellow-400 hover:bg-yellow-400 hover:text-black transition-all duration-300 px-8 py-4 rounded-lg mt-6 text-lg"
          >Contactar</a
        >
      </div>

      <!-- Flecha indicadora de scroll -->
      <div
        class="absolute bottom-10 left-1/2 transform -translate-x-1/2 animate-bounce"
      >
        <div
          class="w-6 h-10 border-2 border-yellow-400 rounded-full flex justify-center"
        >
          <div class="w-1 h-3 bg-yellow-400 rounded-full mt-2 animate-pulse">
          </div>
        </div>
      </div>
    </section>

    <!-- Proyectos -->
    <section id="projects" class="py-20 px-4 sm:px-10">
      <div class="container mx-auto">
        <h2 class="text-4xl mb-12 text-center">
          Mis <span class="text-yellow-400">Proyectos</span>
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="card-bat group">
            <div
              class="h-48 bg-gray-800 rounded-t-lg flex items-center justify-center"
            >
              <span class="text-5xl">🦇</span>
            </div>
            <div class="p-6">
              <h3 class="text-xl mb-3">Proyecto Batman</h3>
              <p class="text-gray-400">
                Sistema de vigilancia para Gotham City con tecnología de
                vanguardia.
              </p>
              <div class="mt-4 flex gap-3">
                <span class="text-xs px-2 py-1 bg-gray-800 rounded-md"
                  >React</span
                >
                <span class="text-xs px-2 py-1 bg-gray-800 rounded-md"
                  >Node.js</span
                >
              </div>
            </div>
          </div>

          <div class="card-bat group">
            <div
              class="h-48 bg-gray-800 rounded-t-lg flex items-center justify-center"
            >
              <span class="text-5xl">🌃</span>
            </div>
            <div class="p-6">
              <h3 class="text-xl mb-3">Gotham Database</h3>
              <p class="text-gray-400">
                Base de datos criminalística para el departamento de policía de
                Gotham.
              </p>
              <div class="mt-4 flex gap-3">
                <span class="text-xs px-2 py-1 bg-gray-800 rounded-md"
                  >MongoDB</span
                >
                <span class="text-xs px-2 py-1 bg-gray-800 rounded-md"
                  >Express</span
                >
              </div>
            </div>
          </div>

          <div class="card-bat group">
            <div
              class="h-48 bg-gray-800 rounded-t-lg flex items-center justify-center"
            >
              <span class="text-5xl">🚓</span>
            </div>
            <div class="p-6">
              <h3 class="text-xl mb-3">Batmovil UI</h3>
              <p class="text-gray-400">
                Interfaz de control para el vehículo emblemático del caballero
                oscuro.
              </p>
              <div class="mt-4 flex gap-3">
                <span class="text-xs px-2 py-1 bg-gray-800 rounded-md">Vue</span
                >
                <span class="text-xs px-2 py-1 bg-gray-800 rounded-md"
                  >WebGL</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Habilidades -->
    <section class="py-20 px-4 sm:px-10 bg-gray-900">
      <div class="container mx-auto">
        <h2 class="text-4xl mb-12 text-center">
          Mis <span class="text-yellow-400">Habilidades</span>
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div class="flex flex-col items-center p-6 card-bat">
            <div class="text-4xl mb-4">⚡</div>
            <h3 class="text-lg mb-2">Frontend</h3>
            <p class="text-sm text-gray-400 text-center">
              React, Vue, Astro, Tailwind
            </p>
          </div>

          <div class="flex flex-col items-center p-6 card-bat">
            <div class="text-4xl mb-4">🔧</div>
            <h3 class="text-lg mb-2">Backend</h3>
            <p class="text-sm text-gray-400 text-center">
              Node.js, Express, MongoDB
            </p>
          </div>

          <div class="flex flex-col items-center p-6 card-bat">
            <div class="text-4xl mb-4">🎨</div>
            <h3 class="text-lg mb-2">Design</h3>
            <p class="text-sm text-gray-400 text-center">
              Figma, UI/UX, Prototyping
            </p>
          </div>

          <div class="flex flex-col items-center p-6 card-bat">
            <div class="text-4xl mb-4">🚀</div>
            <h3 class="text-lg mb-2">DevOps</h3>
            <p class="text-sm text-gray-400 text-center">Docker, AWS, CI/CD</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contacto -->
    <section id="contact" class="py-20 px-4 sm:px-10">
      <div class="container mx-auto max-w-4xl">
        <h2 class="text-4xl mb-12 text-center">
          ¿Interesado en <span class="text-yellow-400">trabajar juntos</span>?
        </h2>

        <div class="grid md:grid-cols-2 gap-10 items-start">
          <div>
            <h3 class="text-2xl mb-4">Envíame un mensaje</h3>
            <p class="text-gray-400 mb-6">
              ¿Tienes un proyecto en mente? Envíame un mensaje y hagámoslo
              realidad.
            </p>

            <div class="space-y-4">
              <div class="flex items-center">
                <div
                  class="w-10 h-10 rounded-full bg-yellow-400 flex items-center justify-center mr-3"
                >
                  <span class="text-black">📧</span>
                </div>
                <div>
                  <p class="text-sm text-gray-400">Email</p>
                  <p class="text-yellow-400">contacto@ejemplo.com</p>
                </div>
              </div>

              <div class="flex items-center">
                <div
                  class="w-10 h-10 rounded-full bg-yellow-400 flex items-center justify-center mr-3"
                >
                  <span class="text-black">📱</span>
                </div>
                <div>
                  <p class="text-sm text-gray-400">Teléfono</p>
                  <p class="text-yellow-400">+1 (555) 123-4567</p>
                </div>
              </div>
            </div>
          </div>

          <form class="space-y-6 card-bat p-6">
            <div>
              <label for="name" class="block text-gray-300 mb-2"
                >Tu Nombre</label
              >
              <input
                type="text"
                id="name"
                placeholder="Bruce Wayne"
                class="w-full p-3 bg-gray-800 text-white rounded-lg border border-gray-700 focus:border-yellow-400 focus:outline-none transition-colors"
              />
            </div>

            <div>
              <label for="email" class="block text-gray-300 mb-2"
                >Tu Correo</label
              >
              <input
                type="email"
                id="email"
                placeholder="bruce@wayne-enterprises.com"
                class="w-full p-3 bg-gray-800 text-white rounded-lg border border-gray-700 focus:border-yellow-400 focus:outline-none transition-colors"
              />
            </div>

            <div>
              <label for="message" class="block text-gray-300 mb-2"
                >Tu Mensaje</label
              >
              <textarea
                id="message"
                placeholder="Necesito una aplicación para combatir el crimen en Gotham..."
                class="w-full p-3 bg-gray-800 text-white rounded-lg border border-gray-700 focus:border-yellow-400 focus:outline-none transition-colors h-32"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full btn-bat py-4 text-lg font-bold mt-4"
            >
              Enviar Mensaje
            </button>
          </form>
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Layout>

<style>
  /* Asegurar que los controles de lluvia estén por encima del canvas */

  /* Animación personalizada para la flecha de scroll */
  @keyframes bounce {
    0%,
    20%,
    50%,
    80%,
    100% {
      transform: translateY(0) translateX(-50%);
    }
    40% {
      transform: translateY(-10px) translateX(-50%);
    }
    60% {
      transform: translateY(-5px) translateX(-50%);
    }
  }

  .animate-bounce {
    animation: bounce 2s infinite;
  }
</style>
