---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackgroundAnimation from "../components/BackgroundAnimation.astro";
import WaterDrops from "../components/WaterDrops.astro";
import Smoke from "../components/Smoke.astro";
---

<Layout
  title="Santiago López | Desarrollador Full Stack & Especialista en Ciberseguridad"
  description="Desarrollador de software especializado en soluciones seguras con expertise en HTML, CSS, JavaScript, TypeScript, Python, Bash, SQL y Java."
>
  <Smoke />
  <BackgroundAnimation />
  
  <div class="relative z-10">
    <WaterDrops />
    
    <Header />

    <!-- Hero Section Mejorado -->
    <section class="min-h-screen flex flex-col justify-center items-center text-center px-4 relative overflow-hidden">
      <!-- Elementos decorativos de tecnología -->
      <div class="absolute top-20 left-5 w-72 h-72 bg-blue-500/5 rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 right-5 w-96 h-96 bg-emerald-500/5 rounded-full blur-3xl"></div>
      
      <!-- Código flotante decorativo -->
      <div class="absolute top-1/4 left-10 opacity-10 text-sm font-mono">
        &lt;div class="container"&gt;<br>
        &nbsp;&nbsp;&lt;h1&gt;Code&lt;/h1&gt;<br>
        &lt;/div&gt;
      </div>
      
      <div class="relative z-20 max-w-6xl mx-auto">
        <!-- Badge profesional -->
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-gray-900/80 backdrop-blur-sm border border-gray-700 rounded-full mb-8">
          <div class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></div>
          <span class="text-sm text-gray-300">📍 Pasto, Colombia | 💼 Disponible Remoto</span>
        </div>
        
        <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-7xl font-bold mb-6 tracking-tight">
          <span class="block text-white mb-2">Santiago López</span>
          <span class="block text-transparent bg-clip-text bg-gradient-to-r from-blue-500 via-emerald-500 to-blue-600 text-4xl md:text-5xl lg:text-6xl">
            Full Stack Developer
          </span>
        </h1>
        
        <p class="mt-8 text-gray-300 max-w-3xl text-lg md:text-xl leading-relaxed mx-auto">
          Construyo <span class="text-emerald-400 font-semibold">soluciones digitales robustas</span> 
          combinando desarrollo full stack con principios de 
          <span class="text-blue-400 font-semibold"> ciberseguridad</span>. 
          Especializado en crear aplicaciones escalables, seguras y eficientes.
        </p>

        <!-- Tecnologías en Badges -->
        <div class="mt-12 flex flex-wrap justify-center gap-3 max-w-3xl mx-auto">
          <span class="px-4 py-2 bg-gray-800/50 border border-gray-700 rounded-full text-sm text-emerald-300">
            HTML5
          </span>
          <span class="px-4 py-2 bg-gray-800/50 border border-gray-700 rounded-full text-sm text-blue-300">
            CSS3
          </span>
          <span class="px-4 py-2 bg-gray-800/50 border border-gray-700 rounded-full text-sm text-yellow-300">
            JavaScript
          </span>
          <span class="px-4 py-2 bg-gray-800/50 border border-gray-700 rounded-full text-sm text-blue-400">
            TypeScript
          </span>
          <span class="px-4 py-2 bg-gray-800/50 border border-gray-700 rounded-full text-sm text-green-400">
            Python
          </span>
          <span class="px-4 py-2 bg-gray-800/50 border border-gray-700 rounded-full text-sm text-gray-300">
            Bash
          </span>
          <span class="px-4 py-2 bg-gray-800/50 border border-gray-700 rounded-full text-sm text-purple-300">
            SQL
          </span>
          <span class="px-4 py-2 bg-gray-800/50 border border-gray-700 rounded-full text-sm text-red-300">
            Java
          </span>
        </div>

        <!-- CTA Buttons -->
        <div class="mt-12 flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/projects" 
            class="group relative px-8 py-4 text-lg font-semibold rounded-lg overflow-hidden transition-all duration-300 hover:scale-105"
          >
            <div class="absolute inset-0 bg-gradient-to-r from-blue-600 to-emerald-600"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-blue-700 to-emerald-700 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <span class="relative flex items-center justify-center gap-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
              </svg>
              Ver Portafolio
            </span>
          </a>
          
          <a 
            href="/contact" 
            class="group px-8 py-4 text-lg font-semibold rounded-lg border-2 border-emerald-500 text-emerald-400 hover:bg-emerald-500 hover:text-white transition-all duration-300 hover:scale-105 flex items-center justify-center gap-3"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            Contactar Ahora
          </a>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 animate-bounce">
        <div class="flex flex-col items-center">
          <span class="text-sm text-gray-400 mb-2">Explorar</span>
          <div class="w-6 h-10 border-2 border-emerald-500 rounded-full flex justify-center relative">
            <div class="w-1 h-3 bg-emerald-500 rounded-full mt-2 animate-pulse"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Tecnologías Detalladas -->
    <section class="py-24 px-4 sm:px-10 bg-gray-900/30 backdrop-blur-sm">
      <div class="container mx-auto max-w-6xl">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold mb-4">
            <span class="text-white">Stack </span>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-emerald-500">Tecnológico</span>
          </h2>
          <p class="text-gray-400 text-lg max-w-3xl mx-auto">
            Dominio completo del ciclo de desarrollo con las tecnologías más demandadas del mercado
          </p>
