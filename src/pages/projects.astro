---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackgroundAnimation from "../components/BackgroundAnimation.astro";
import WaterDrops from "../components/WaterDrops.astro";
import Smoke from "../components/Smoke.astro";

const projects = [
  {
    id: 1,
    title: "Sistema para gimnasios",
    description: "Sistema para gestionar y administrar gimnasios.",
    category: "Full-Stack",
    technologies: ["Astro", "Tailwind", "Java"],
    link: "https://github.com/THEBAT02468/SistemaGym",
    image: "/images/project1.jpg",
    color: "#FFD700",
    glow: "rgba(255,215,0,0.3)",
  },
  {
    id: 2,
    title: "Clothes-Bot",
    description: "Bot de clothing para WhatsApp.",
    category: "Full-Stack",
    technologies: ["Python", "Django", "PostgreSQL"],
    link: "https://github.com/THEBAT02468/clothesBot",
    image: "/images/project2.png",
    color: "#FFD700",
    glow: "rgba(255,215,0,0.3)",
  },
  {
    id: 3,
    title: "Bat-Findbug",
    description: "Herramienta de análisis estático para detectar vulnerabilidades de seguridad en dominios web.",
    category: "Cybersecurity",
    technologies: ["Python", "Flask", "SQLite"],
    link: "https://github.com/THEBAT02468/Bat-FindBug",
    image: "/images/project3.png",
    color: "#ff6b6b",
    glow: "rgba(255,107,107,0.3)",
  },
  {
    id: 4,
    title: "LegacyApp",
    description: "Aplicación fitness del gimnasio Legacy para organizar rutinas, dietas, instructores y equipos.",
    category: "Mobile",
    technologies: ["React-Native", "Expo", "Firebase"],
    link: "https://expo.dev/accounts/thebat02468/projects/LegacyApp/builds/e93361a2-4e41-4183-84a0-669b7f2240be",
    image: "/images/legacyGym.jpg",
    color: "#8b5cf6",
    glow: "rgba(139,92,246,0.3)",
  },
  {
    id: 5,
    title: "AnimusHacking",
    description: "Semillero universitario de Hacking y Pentesting con contenidos de seguridad y vulnerabilidades.",
    category: "Cybersecurity",
    technologies: ["Kali", "Metasploit", "Burp Suite"],
    link: "https://chat.whatsapp.com/Fbd7IPsRXZF6v5fUjgbeHh?mode=gi_t",
    image: "/images/LogoAnimusHacking.png",
    color: "#ff6b6b",
    glow: "rgba(255,107,107,0.3)",
  },
  {
    id: 6,
    title: "Analista de Datos",
    description: "Analista computacional de datos para Ingeniería Aplicada ITD SAS, con modelos predictivos.",
    category: "Data Science",
    technologies: ["Python", "Scikit-learn", "Pandas", "Numpy"],
    image: "/images/Ing_Aplicada_ITD_SAS.png",
    color: "#00d4ff",
    glow: "rgba(0,212,255,0.3)",
  },
  {
    id: 7,
    title: "Code-Quest",
    description: "Plataforma gamificada para aprender a programar con feedback inmediato para estudiantes.",
    category: "Full-Stack",
    technologies: ["Python", "Flask", "MySQL", "HTML", "CSS", "JavaScript"],
    link: "https://code-quest.up.railway.app/",
    image: "/images/Code-Quest.png",
    color: "#FFD700",
    glow: "rgba(255,215,0,0.3)",
  },
  {
    id: 8,
    title: "Maquina Gotham Dockerlabs",
    description: "Manipulación de cookie de sesión (JWT) → command injection → password reuse → sudo misconfig.",
    category: "Cybersecurity",
    technologies: ["Docker", "Linux", "Pentesting"],
    link: "https://dockerlabs.es/",
    source: "/MÁQUINA GOTHAM.pdf",
    image: "/images/project4.png",
    color: "#ff6b6b",
    glow: "rgba(255,107,107,0.3)",
  },
];

const categories = ["Todos", "Full-Stack", "Cybersecurity", "Mobile", "Data Science"];
---

<Layout title="Proyectos - Santiago López | Gotham Developer">
  <Smoke />
  <BackgroundAnimation />
  <div class="relative z-10">
    <WaterDrops />
    <Header />

    <!-- ── HERO ──────────────────────────────────────── -->
    <section class="relative pt-32 pb-16 px-6 text-center overflow-hidden">
      <div class="absolute inset-0" style="background: rgba(0,0,0,0.50);">
        <div class="absolute inset-0 gotham-grid opacity-50"></div>
      </div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(255,215,0,0.05) 0%, transparent 65%);"></div>
      <div class="absolute bottom-0 left-0 right-0 h-px" style="background: linear-gradient(90deg, transparent, rgba(255,215,0,0.4), transparent); box-shadow: 0 0 8px rgba(255,215,0,0.3);"></div>

      <div class="relative z-10">
        <div class="inline-flex items-center gap-3 px-5 py-2 mb-8" style="background: rgba(0,0,0,0.8); border: 1px solid rgba(255,215,0,0.4); box-shadow: 0 0 20px rgba(255,215,0,0.1);">
          <div class="w-2 h-2 rounded-full animate-pulse" style="background: #00d4ff; box-shadow: 0 0 6px #00d4ff;"></div>
          <span class="text-xs font-black tracking-widest uppercase" style="color: #FFD700; font-family: 'Cinzel', serif; letter-spacing: 0.15em; text-shadow: 0 0 8px rgba(255,215,0,0.6);" data-i18n="proj.badge">⬡ Portafolio ⬡</span>
        </div>

        <h1 class="font-black mb-4" style="font-family: 'Cinzel Decorative', serif; font-size: clamp(2.5rem, 8vw, 6rem); letter-spacing: 0.05em; line-height: 1;">
          <span class="text-white" data-i18n="proj.h1">MIS</span>
          <span class="block" style="color: #FFD700; text-shadow: 0 0 30px rgba(255,215,0,0.8), 0 0 60px rgba(255,215,0,0.4);" data-i18n="proj.h2">PROYECTOS</span>
        </h1>

        <p class="text-gray-500 text-base md:text-lg max-w-2xl mx-auto mt-4" data-i18n="proj.hero.desc">
          Creaciones con temática oscura e inspiradas en Gotham City — donde el código se convierte en arte.
        </p>
      </div>
    </section>

    <!-- ── PROYECTOS GRID ─────────────────────────────── -->
    <main class="relative px-4 md:px-6 py-16 overflow-hidden">
      <div class="absolute inset-0" style="background: rgba(0,0,0,0.50);">
        <div class="absolute inset-0 gotham-grid opacity-30"></div>
      </div>

      <!-- Filtros -->
      <div class="relative z-10 flex justify-center mb-12 gap-3 flex-wrap">
        {categories.map((cat, i) => (
          <button
            class="filter-btn text-xs font-black tracking-widest uppercase px-5 py-2 transition-all duration-300"
            data-category={cat}
            style={i === 0
              ? "background: rgba(255,215,0,0.12); color: #FFD700; border: 1px solid rgba(255,215,0,0.6); box-shadow: 0 0 12px rgba(255,215,0,0.2); font-family: 'Cinzel', serif; letter-spacing: 0.12em;"
              : "color: #6b7280; border: 1px solid rgba(255,255,255,0.08); font-family: 'Cinzel', serif; letter-spacing: 0.12em;"}
          >
            {cat === 'Todos' ? <span data-i18n="proj.filter.all">Todos</span> : cat}
          </button>
        ))}
      </div>

      <!-- Cards grid -->
      <div class="relative z-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-7xl mx-auto" id="projects-grid">
        {projects.map((project) => (
          <div
            class="project-card group relative overflow-hidden transition-all duration-400"
            data-category={project.category}
            style={`background: #000; border: 1px solid ${project.color}30; box-shadow: 0 4px 24px rgba(0,0,0,0.9);`}
            onmouseover={`this.style.borderColor='${project.color}80'; this.style.boxShadow='0 0 25px ${project.glow}, 0 8px 40px rgba(0,0,0,1)'; this.style.transform='translateY(-6px)';`}
            onmouseout={`this.style.borderColor='${project.color}30'; this.style.boxShadow='0 4px 24px rgba(0,0,0,0.9)'; this.style.transform='translateY(0)';`}
          >
            <!-- Neon top line -->
            <div class="absolute top-0 left-0 right-0 h-0.5 z-10 transition-opacity duration-300"
              style={`background: linear-gradient(90deg, transparent, ${project.color}, transparent); opacity: 0.6;`}></div>

            <!-- Category badge -->
            <div class="absolute top-3 right-3 z-10 px-2 py-0.5 text-xs font-black tracking-wider uppercase"
              style={`background: rgba(0,0,0,0.9); border: 1px solid ${project.color}60; color: ${project.color}; font-family: 'Cinzel', serif; font-size: 0.55rem; letter-spacing: 0.1em;`}>
              {project.category}
            </div>

            <!-- Image -->
            <div class="h-44 overflow-hidden relative" style="background: #080808;">
              <img
                src={project.image}
                alt={project.title}
                width="400"
                height="240"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110 opacity-80 group-hover:opacity-100"
              />
              <!-- Overlay gradiente -->
              <div class="absolute inset-0" style={`background: linear-gradient(to top, #000 0%, transparent 60%);`}></div>
            </div>

            <!-- Content -->
            <div class="p-5">
              <h3 class="text-base font-black mb-2 transition-all duration-300"
                style={`color: ${project.color}; font-family: 'Cinzel', serif; letter-spacing: 0.06em; text-shadow: 0 0 8px ${project.glow};`}>
                {project.title}
              </h3>
              <p class="text-gray-500 text-sm mb-4 leading-relaxed">{project.description}</p>

              <!-- Tech badges -->
              <div class="flex flex-wrap gap-2 mb-5">
                {project.technologies.map((tech) => (
                  <span class="text-xs font-bold px-2 py-0.5 tracking-wide"
                    style={`border: 1px solid ${project.color}40; color: ${project.color}; background: ${project.color}08; font-family: 'Cinzel', serif; font-size: 0.6rem; letter-spacing: 0.08em;`}>
                    {tech}
                  </span>
                ))}
              </div>

              <!-- Link -->
              <div class="flex flex-wrap items-center gap-4">
                {project.link ? (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-xs font-black tracking-widest uppercase transition-all duration-300 hover:gap-3"
                    style={`color: ${project.color}; font-family: 'Cinzel', serif; letter-spacing: 0.1em; text-shadow: 0 0 6px ${project.glow};`}
                  >
                    <span data-i18n="proj.view">Ver proyecto</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                ) : !project.source ? (
                  <span class="text-xs font-bold tracking-widest uppercase" style="color: #4b5563; font-family: 'Cinzel', serif; font-size: 0.6rem;" data-i18n="proj.done">Terminado</span>
                ) : null}
                {project.source && (
                  <a
                    href={project.source}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-xs font-black tracking-widest uppercase transition-all duration-300 hover:gap-3"
                    style={`color: ${project.color}; font-family: 'Cinzel', serif; letter-spacing: 0.1em; text-shadow: 0 0 6px ${project.glow};`}
                  >
                    <span data-i18n="proj.writeup">Ver writeup</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Empty state (oculto por defecto) -->
      <div id="no-results" class="hidden relative z-10 text-center py-20">
        <p class="font-black text-2xl" style="color: #FFD700; font-family: 'Cinzel Decorative', serif; text-shadow: 0 0 20px rgba(255,215,0,0.5);" data-i18n="proj.empty">Sin proyectos en esta categoría</p>
      </div>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .project-card { transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease; }

  .filter-btn:hover {
    color: #FFD700 !important;
    border-color: rgba(255,215,0,0.5) !important;
    background: rgba(255,215,0,0.06) !important;
  }

  .filter-btn.active {
    background: rgba(255,215,0,0.12) !important;
    color: #FFD700 !important;
    border-color: rgba(255,215,0,0.6) !important;
    box-shadow: 0 0 12px rgba(255,215,0,0.2) !important;
  }

  main { padding-top: 0; }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    const filterBtns = document.querySelectorAll(".filter-btn");
    const cards = document.querySelectorAll(".project-card");
    const noResults = document.getElementById("no-results");

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", function () {
        const category = this.dataset.category;

        // Update active button
        filterBtns.forEach((b) => b.classList.remove("active"));
        this.classList.add("active");

        let visible = 0;
        cards.forEach((card) => {
          const cardCategory = card.dataset.category;
          const matches = category === "Todos" || cardCategory === category;
          card.style.display = matches ? "block" : "none";
          if (matches) visible++;
        });

        if (noResults) noResults.style.display = visible === 0 ? "block" : "none";
      });
    });

    // Activate first button
    const firstBtn = document.querySelector(".filter-btn");
    if (firstBtn) firstBtn.classList.add("active");
  });
</script>
